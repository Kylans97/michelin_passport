---
// One event in a list. Carries its own end date and timezone so the page
// can hide it once it has ended where it takes place (HideEnded), even
// when the last build is a few days old.
import { formatWhen, place, type SiteEvent } from '../lib/events';

interface Props { event: SiteEvent; onGreen?: boolean; }
const { event: e, onGreen = false } = Astro.props;
const host = e.venues.find((v) => v.roles.includes('host'));
---
<li class:list={['row', { 'on-green': onGreen }]} data-end-date={e.endDate} data-tz={e.timezone ?? 'Europe/Amsterdam'}>
  <a href={`/events/${e.slug}`}>
    <span class="when">{formatWhen(e)}</span>
    <span class="display name">{e.name}</span>
    <span class="meta">
      {[e.type, host ? `Hosted by ${host.name}` : e.venueName, place(e)].filter(Boolean).join(' · ')}
      {e.cancelled && <span class="cancelled"> · Cancelled</span>}
    </span>
  </a>
</li>

<style>
  .row { border-bottom: 1px solid var(--rule); }
  .row a { display: grid; grid-template-columns: 13em minmax(0, 1fr); column-gap: 20px; padding: 14px 0; }
  .row a:hover { text-decoration: none; }
  .row a:hover .name { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .when { font-family: var(--util); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--taupe); padding-top: 6px; grid-row: span 2; }
  .name { font-size: 21px; line-height: 1.2; }
  .meta { font-size: 13px; color: var(--ink-soft); grid-column: 2; }
  .cancelled { color: var(--green); font-weight: 500; }

  .on-green { border-bottom-color: rgba(244, 240, 231, 0.18); }
  .on-green .when { color: var(--on-green-accent); }
  .on-green .meta { color: var(--on-green-muted); }
  .on-green .cancelled { color: var(--ivory); }

  @media (max-width: 760px) {
    .row a { grid-template-columns: minmax(0, 1fr); row-gap: 2px; }
    .when { grid-row: auto; padding-top: 0; }
    .meta { grid-column: 1; }
  }
</style>
