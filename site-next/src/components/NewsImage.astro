---
// A Supabase photo, resized at build time and cropped around its stored
// focus point, the way the app crops it.
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  widths: number[];
  sizes: string;
  focusX?: number;
  focusY?: number;
  ratio?: string;
  eager?: boolean;
}
const { src, alt, widths, sizes, focusX = 0.5, focusY = 0.5, ratio, eager = false } = Astro.props;
const position = `${Math.round(focusX * 100)}% ${Math.round(focusY * 100)}%`;
---
<Image
  src={src}
  alt={alt}
  inferSize
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={78}
  loading={eager ? 'eager' : 'lazy'}
  style={`object-fit:cover;object-position:${position};width:100%;height:100%;${ratio ? `aspect-ratio:${ratio};` : ''}`}
/>
