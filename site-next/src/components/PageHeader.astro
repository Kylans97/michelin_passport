---
// The top of every section page: a full-width green band carrying the
// page's name, so a page opens on colour rather than on an empty ivory
// field. An optional `aside` slot sits on the right on wide screens.
interface Props { eyebrow?: string; title: string; intro?: string; }
const { eyebrow, title, intro } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<header class="band">
  <div class:list={['wrap', 'inner', { split: hasAside }]}>
    <div>
      {eyebrow && <p class="eyebrow kicker"><Fragment set:html={eyebrow} /></p>}
      <h1 class="display">{title}</h1>
      {intro && <p class="intro">{intro}</p>}
    </div>
    {hasAside && <div class="aside"><slot name="aside" /></div>}
  </div>
</header>

<style>
  .band { background: var(--green); color: var(--ivory); }
  .inner { padding-top: 88px; padding-bottom: 80px; max-width: 1200px; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: end; }
  .kicker { color: var(--on-green-accent); margin-bottom: 12px; }
  .kicker :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  h1 { font-weight: 300; font-size: clamp(44px, 6.4vw, 92px); line-height: 1; letter-spacing: -0.02em; }
  .intro { color: var(--on-green-muted); max-width: 52ch; margin: 22px 0 0; font-size: 19px; line-height: 1.55; }
  @media (max-width: 760px) {
    .inner { padding-top: 48px; padding-bottom: 44px; }
    .split { grid-template-columns: minmax(0, 1fr); align-items: start; }
  }
</style>
