---
import NewsImage from './NewsImage.astro';
import { formatNewsDate, sectionLabel, type NewsArticle } from '../lib/news';

interface Props {
  article: NewsArticle;
  /** lead: the big story; card: a grid card; row: a text-only line. */
  variant?: 'lead' | 'card' | 'row';
}
const { article, variant = 'card' } = Astro.props;
const href = `/news/${article.slug}`;
const meta = `${sectionLabel(article.section)} · ${formatNewsDate(article.publishedAt)}`;
---
<article class={`card ${variant}`}>
  <a href={href} class="link">
    {variant !== 'row' && (
      <div class="photo">
        {article.imageUrl
          ? <NewsImage
              src={article.imageUrl}
              alt=""
              widths={variant === 'lead' ? [640, 960, 1400] : [400, 720]}
              sizes={variant === 'lead' ? '(max-width: 760px) 100vw, 640px' : '(max-width: 760px) 100vw, 360px'}
              focusX={article.focusX}
              focusY={article.focusY}
              eager={variant === 'lead'}
            />
          : <div class="blank" />}
      </div>
    )}
    <p class="eyebrow">{meta}</p>
    <h3 class="display title">{article.shortTitle}</h3>
  </a>
</article>

<style>
  .link { display: flex; flex-direction: column; gap: 8px; }
  .link:hover { text-decoration: none; }
  .link:hover .title { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .photo { overflow: hidden; border-radius: 4px; background: var(--placeholder); }
  .blank { width: 100%; height: 100%; }
  .lead .photo { aspect-ratio: 4 / 3; margin-bottom: 6px; }
  .card .photo { aspect-ratio: 4 / 3; }
  .lead .title { font-size: clamp(30px, 3.6vw, 40px); }
  .card .title { font-size: 21px; line-height: 1.2; }
  .row { border-bottom: 1px solid var(--rule); padding-bottom: 14px; }
  .row .title { font-size: 20px; line-height: 1.2; }
</style>
