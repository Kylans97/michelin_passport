---
import { SECTIONS } from '../config';
import AppCta from './AppCta.astro';

interface Props { current?: string; }
const { current } = Astro.props;
---
<header class="nav">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="Mantelier, home">MANTELIER</a>
    <nav aria-label="Sections">
      <ul>
        {SECTIONS.map((s) => (
          <li>
            <a href={`/${s.slug}`} aria-current={current === s.slug ? 'page' : undefined}>{s.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="end">
      <a class="account" href="/account/sign-in" data-account><span class="name" data-name>Sign in</span><span class="initial" data-initial aria-hidden="true"></span></a>
      <AppCta label="Get the app" variant="ivory" />
    </div>
  </div>
</header>

<script>
  // "Sign in" until a session is stored, then the member's name. Reads
  // what supabase-js stored without loading it; the account pages check
  // the session for real.
  import { peek, showMemberInHeader, signInHref, storedName } from '../lib/account/peek';

  const link = document.querySelector<HTMLAnchorElement>('[data-account]');
  if (link) {
    if (peek() === 'signed-in') {
      showMemberInHeader(storedName());
    } else if (!location.pathname.startsWith('/account')) {
      link.href = signInHref();
    }
  }
</script>

<style>
  .nav { background: var(--green); color: var(--ivory); border-bottom: 1px solid var(--on-green-rule); }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
    min-height: 68px;
  }
  .wordmark {
    font-family: var(--display);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 0.16em;
  }
  .wordmark:hover { text-decoration: none; }
  ul {
    display: flex;
    justify-content: center;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--on-green-muted);
  }
  ul a:hover { color: var(--ivory); }
  .end { display: flex; align-items: center; gap: 18px; }
  .account { font-size: 13px; color: var(--ivory); white-space: nowrap; }
  .name { display: block; max-width: 16ch; overflow: hidden; text-overflow: ellipsis; }
  .initial { display: none; }
  a[aria-current='page'] { color: var(--ivory); text-decoration: underline; text-underline-offset: 6px; }

  @media (max-width: 760px) {
    .bar { grid-template-columns: 1fr auto; row-gap: 0; padding-top: 12px; }
    .end { gap: 12px; }
    .member .name { display: none; }
    .member .initial {
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid var(--on-green-accent);
      font-family: var(--display);
      font-size: 17px;
    }
    .member:hover { text-decoration: none; }
    nav { grid-column: 1 / -1; grid-row: 2; overflow-x: auto; scrollbar-width: none; }
    nav::-webkit-scrollbar { display: none; }
    ul { justify-content: flex-start; gap: 22px; padding: 12px 0 14px; white-space: nowrap; }
  }
</style>
