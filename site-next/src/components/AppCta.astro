---
// "Continue in the app": the one way the site points into the app.
// Reading happens here; following, saving and planning happen there.
// Until APP_STORE_URL is set it is a quiet label, never a dead link.
// It goes through /app-store, so Studio can count it (see config.ts).
import { APP_STORE_LINK } from '../config';

interface Props {
  label: string;
  variant?: 'outline' | 'solid' | 'on-green' | 'ivory';
  /** large: the Keynote pill for a section's one call to action. */
  size?: 'small' | 'large';
}
const { label, variant = 'outline', size = 'small' } = Astro.props;
const href = APP_STORE_LINK;
---
{href
  ? <a class={`cta ${variant} ${size}`} href={href}>{label}</a>
  : <span class={`cta ${variant} ${size} pending`} title="Coming to the App Store">{label}</span>}

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    border-radius: 999px;
    padding: 6px 14px;
    white-space: nowrap;
  }
  a.cta:hover { text-decoration: none; opacity: 0.88; }
  .outline { border: 1px solid var(--green); color: var(--green); }
  .solid { background: var(--green); color: var(--ivory); border: 1px solid var(--green); }
  .on-green { border: 1px solid var(--on-green-accent); color: var(--ivory); }
  .ivory { background: var(--ivory); color: var(--green); border: 1px solid var(--ivory); }
  .large { font-size: 16px; font-weight: 600; letter-spacing: 0; padding: 14px 26px; }
  .pending { cursor: default; }
</style>
