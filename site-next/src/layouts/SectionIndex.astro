---
// A section's own front page: the green header band, its newest article
// as a full-width feature, then the rest in a grid.
import Base from './Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FeatureStory from '../components/FeatureStory.astro';
import PageHeader from '../components/PageHeader.astro';
import type { NewsArticle } from '../lib/news';

interface Props { slug: string; label: string; intro: string; articles: NewsArticle[]; empty: string; }
const { slug, label, intro, articles, empty } = Astro.props;
const [lead, ...rest] = articles;
const count = `${articles.length} ${articles.length === 1 ? 'article' : 'articles'}`;
---
<Base title={label} description={intro} current={slug}>
  <PageHeader eyebrow={count} title={label} intro={intro} />
  <section class="wrap body">
    {lead
      ? <FeatureStory article={lead} />
      : <p class="empty">{empty}.</p>}
    {rest.length > 0 && (
      <div class="grid">{rest.map((a) => <ArticleCard article={a} />)}</div>
    )}
  </section>
</Base>

<style>
  .body { padding-top: 48px; }
  .empty { color: var(--ink-soft); font-size: 17px; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin-top: 48px; }
  @media (max-width: 760px) {
    .body { padding-top: 28px; }
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
