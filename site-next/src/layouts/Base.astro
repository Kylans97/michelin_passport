---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { HIDDEN } from '../config';

interface Props {
  title?: string;
  description: string;
  current?: string;
  /** Signed-in pages: never indexed, also after launch. */
  noindex?: boolean;
}
const { title, description, current, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | Mantelier` : 'Mantelier | Restaurant guides and gastronomy events';
// build.format 'file' gives paths like /app.html and /index.html, which
// Cloudflare Pages redirects to /app and /. The canonical names the
// address that is actually served.
const canonicalPath = Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1').replace(/\.html$/, '');
const canonical = new URL(canonicalPath, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {HIDDEN || noindex
    ? <meta name="robots" content="noindex, nofollow">
    : <link rel="canonical" href={canonical}>}

  <meta property="og:title" content={title ?? 'Mantelier'}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#16302A">

  <link rel="icon" href="/favicon-32.png" sizes="32x32">
  <link rel="icon" href="/favicon-192.png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon-180.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet">
  <slot name="head" />
</head>
<body>
  <a class="sr-only" href="#main">Skip to content</a>
  <Nav current={current} />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
