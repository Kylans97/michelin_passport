  $('trip-name').addEventListener('input', () => { $('trip-name-err').hidden = true; });
  $('save-confirm').addEventListener('click', () => {
    const name = $('trip-name').value.trim();
    if (!name) { $('trip-name-err').hidden = false; return; }
    saveTrip(name); $('save-panel').hidden = true;
  });

  // share
  const FRIENDS = ['Sanne', 'Joost', 'Mila', 'Ruben'];
  const shared = new Set();
  $('share-friends').innerHTML = FRIENDS.map((f) => `<button type="button" class="chip" aria-pressed="false">${f}</button>`).join('');
  $('share-friends').addEventListener('click', (e) => { const b = e.target.closest('.chip'); if (!b) return; const n = b.textContent;
