---
import Base from '../layouts/Base.astro';
import { loadCatalogue } from '../lib/restaurants';

// Off the beaten track: the clickable prototype of the trip planner
// (product owner, 2026-11-16), reached from the footer compass. No real
// AI yet; the proposal is an example built on real catalogue hotels and
// restaurants. Its markup, styles and script come from the prototype
// artifact, scoped under .otbt so they can't touch the rest of the site.

// Restaurants in the example link to their pages here, resolved by
// restaurant code, never by name.
const CODES = ['rest_0141', 'rest_1578', 'rest_0135', 'rest_1381', 'rest_0139', 'rest_0134'];
const { restaurants } = await loadCatalogue();
const links = Object.fromEntries(
  restaurants.filter((r) => CODES.includes(r.code)).map((r) => [r.code, `/restaurants/${r.slug}`]),
);
---
<Base title="Off the beaten track" description="Plan a journey around the table: tell us who's travelling, where and when, and get a route with the hotels and restaurants worth the trip.">
  <div class="otbt">
<header class="band">
  <div class="gutter"><div class="col inner">
    <div class="brand">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M15.5 8.5 13.4 13.4 8.5 15.5 10.6 10.6Z"/></svg>
      <span>Mantelier · Off the beaten track</span>
    </div>
    <h1>Plan a journey around the table</h1>
    <p>Tell us who's travelling, where and when, and how you like to travel. We'll come back with a route that pairs the places worth the journey with the hotels and evenings around them.</p>
    <span class="proto">Prototype · no real AI yet · the proposal is an example</span>
  </div></div>
</header>

<div class="gutter">
  <div class="col">

    <!-- INTAKE -->
    <div id="intake" class="view">
      <div class="mytrips" id="mytrips" hidden></div>
      <ol class="steps" id="steps" aria-label="Steps"></ol>

      <form id="form" novalidate>
        <!-- 1 Who -->
        <fieldset data-step="0">
          <legend><h2>Who's travelling</h2><p class="lead">Nationality decides which government's travel advice applies, and with it what your travel insurance covers.</p></legend>
          <div class="field">
            <span class="q" id="trav-q">Travellers</span>
            <div id="travellers" class="advice" aria-labelledby="trav-q"></div>
            <div><button type="button" class="chip" id="add-trav">+ Add a traveller</button></div>
          </div>
          <div class="row">
            <div class="field"><label for="children">Children (under 18)</label><input id="children" type="number" min="0" max="8" value="0"></div>
            <div class="field"><label for="occasion">Occasion</label>
              <select id="occasion"><option>No particular occasion</option><option selected>An anniversary</option><option>Honeymoon</option><option>A birthday</option><option>Family trip</option></select></div>
          </div>
        </fieldset>

        <!-- 2 Where and when -->
        <fieldset data-step="1" hidden>
          <legend><h2>Where and when</h2><p class="lead">Leave from one place and come home from another if that suits the route.</p></legend>
          <div class="field">
            <span class="q" id="countries-q">Countries</span>
            <div class="chips" id="countries" role="group" aria-labelledby="countries-q"></div>
            <p class="error" id="countries-err" hidden>Choose at least one country.</p>
          </div>
          <div class="row">
            <div class="field"><label for="from">Leaving from</label><input id="from" type="text" value="Amsterdam"></div>
            <div class="field"><label for="to">Coming home to</label><input id="to" type="text" value="Amsterdam"></div>
          </div>
          <div class="row">
            <div class="field"><label for="start">Departure</label><input id="start" type="date" value="2027-04-10"></div>
            <div class="field"><label for="end">Return</label><input id="end" type="date" value="2027-04-23"></div>
          </div>
          <p class="error" id="dates-err" hidden>The return date must come after the departure date.</p>
          <div class="field"><label for="flex">How flexible are the dates?</label>
            <select id="flex"><option value="fixed">These exact dates</option><option value="3" selected>Give or take 3 days</option><option value="7">Give or take a week</option><option value="month">Any time that month</option></select></div>
        </fieldset>

        <!-- 3 Style -->
        <fieldset data-step="2" hidden>
          <legend><h2>How you like to travel</h2><p class="lead">Pick as many as fit. Adventure means different things, so tell us how far you'd go.</p></legend>
          <div class="field">
            <span class="q" id="style-q">Kind of trip</span>
            <div class="chips" id="styles" role="group" aria-labelledby="style-q"></div>
          </div>
          <div class="field">
            <label for="adventure">How adventurous</label>
            <div class="range"><span>Gentle walks</span><input id="adventure" type="range" min="1" max="5" step="1" value="3" aria-describedby="adv-out"><span>Multi-day treks</span></div>
            <p class="hint" id="adv-out"></p>
          </div>
          <div class="field">
            <label for="pace">Pace</label>
            <div class="range"><span>Slow, few moves</span><input id="pace" type="range" min="1" max="5" step="1" value="2"><span>Full and varied</span></div>
          </div>
          <div class="field"><label for="nogo">Anything you'd rather not do</label><textarea id="nogo" placeholder="Night buses, altitude above 4,000 m, cruise ships">Altitude above 4,000 m</textarea></div>
        </fieldset>

        <!-- 4 Budget -->
        <fieldset data-step="3" hidden>
          <legend><h2>Budget and getting around</h2><p class="lead">A rough number is enough. We'll show where it goes, and mark every price as an estimate until it's quoted.</p></legend>
          <div class="row">
            <div class="field"><label for="budget">Budget (€)</label><input id="budget" type="number" min="0" step="500" value="14000"></div>
            <div class="field"><label for="basis">That's</label><select id="basis"><option value="total" selected>For everyone, in total</option><option value="pp">Per person</option></select></div>
          </div>
          <p class="error" id="budget-err" hidden>Enter a budget above zero.</p>
          <label class="check"><input id="flights" type="checkbox" checked> Including international flights</label>
          <div class="row">
            <div class="field"><label for="cabin">Long-haul cabin</label><select id="cabin"><option>Economy</option><option selected>Premium economy</option><option>Business</option></select></div>
            <div class="field"><label for="ground">Getting around there</label><select id="ground"><option>Private driver</option><option selected>Mix of driver and train</option><option>Self-drive</option><option>As few flights as possible</option></select></div>
          </div>
        </fieldset>

        <!-- 5 Table and practicalities -->
        <fieldset data-step="4" hidden>
          <legend><h2>The table, and the practical things</h2><p class="lead">This is where the trip becomes yours.</p></legend>
          <label class="check"><input id="wishlist" type="checkbox" checked> Build around restaurants on my Mantelier wishlist</label>
          <label class="check"><input id="events" type="checkbox" checked> Include one-off events on my dates (four-hands dinners, festivals)</label>
          <div class="field"><label for="diet">Dietary needs and allergies</label><input id="diet" type="text" value="One of us doesn't eat shellfish"></div>
          <div class="field"><label for="mobility">Mobility or health</label><input id="mobility" type="text" placeholder="Anything we should plan around"></div>
          <div class="field"><label for="musts">Must-haves</label><textarea id="musts">One night somewhere truly remote. A dinner we'll talk about for years.</textarea></div>
          <p class="note">For your eyes: in the real version, the travel advice comes from each traveller's own government on the day we write the proposal, with its date and a link, and is checked again before you leave.</p>
        </fieldset>

        <div class="nav">
          <button type="button" class="btn" id="back">Back</button>
          <span class="mono" id="count"></span>
          <button type="submit" class="btn primary" id="next">Next</button>
        </div>
      </form>
    </div>

    <!-- PROPOSAL -->
    <div id="proposal" class="view proposal" hidden>
      <p class="example"><strong>Example proposal.</strong> In this prototype the route is always Peru. The hotels and restaurants are real, from the Mantelier catalogue, with their MICHELIN Keys and World's 50 Best positions as we hold them. The travel-advice colours are illustrations, not the current advice. Flight times are approximate and every amount is an estimate, not a quote. Your dates, travellers and budget are used throughout.</p>

      <div class="tools" id="tools">
        <button type="button" class="btn primary" id="save-btn">Save trip</button>
        <button type="button" class="btn" id="share-btn">Share</button>
        <button type="button" class="btn" id="edit-btn" aria-pressed="false">Edit trip</button>
        <span class="status" id="save-status"></span>
      </div>
      <div class="panel" id="save-panel" hidden>
        <h4>Save this trip</h4>
        <div class="row2">
          <div class="field"><label for="trip-name">Name</label><input id="trip-name" type="text"></div>
          <button type="button" class="btn primary" id="save-confirm">Save</button>
        </div>
        <p class="error" id="trip-name-err" hidden>Give the trip a name.</p>
        <p class="hint">In the app this saves to your Trips, on every device, where friends you invite can plan with you. In this prototype it stays in this browser.</p>
      </div>
      <div class="panel" id="share-panel" hidden>
        <h4>Share this trip</h4>
        <div class="share-opts">
          <div class="share-opt"><strong>With friends on Mantelier</strong>
            <div class="chips" id="share-friends" role="group" aria-label="Friends"></div>
            <span class="hint" id="share-friends-status">Example friends. They'd see the trip in their app and can add ideas.</span></div>
          <div class="share-opt"><strong>WhatsApp</strong><a class="btn" id="share-wa" href="#" target="_blank" rel="noopener">Open WhatsApp</a>
            <span class="hint">Sends the summary below.</span></div>
          <div class="share-opt"><strong>Email</strong><a class="btn" id="share-mail" href="#">Open email</a>
            <span class="hint">If nothing opens, copy the summary instead.</span></div>
        </div>
        <div class="row2" style="align-items:center"><span class="hint" style="flex:1">Summary</span><button type="button" class="btn" id="copy-summary">Copy summary</button></div>
        <div class="summary" id="summary"></div>
        <p class="hint">In the real version this also includes a link to the trip on mantelier.app, readable by anyone you send it to.</p>
      </div>

      <div class="ptitle">
        <p class="eyebrow" id="p-kicker"></p>
        <h2>Peru, from Lima's tables to the Sacred Valley</h2>
        <p id="p-intro"></p>
      </div>

      <dl class="facts" id="p-facts"></dl>

      <section aria-labelledby="adv-h">
        <div class="sec-head"><h3 id="adv-h">Travel advice</h3><span class="mono">Nederland Wereldwijd · example</span></div>
        <div class="advice" id="p-advice"></div>
      </section>

      <section class="journey" aria-labelledby="journey-h">
        <div class="sec-head"><h3 id="journey-h">The journey</h3><button type="button" class="btn" id="play">Play the journey</button></div>
        <div class="j-grid">
          <div class="j-map"><div class="sticky">
            <svg class="map" id="map" viewBox="0 0 600 791" role="img" aria-labelledby="map-t">
              <title id="map-t">Map of Peru with the route: Lima, the Sacred Valley, a day at Machu Picchu, Cusco and back to Lima</title>
            </svg>
            <p class="caption" id="caption" aria-live="polite"></p>
            <svg class="alt" id="alt" viewBox="0 0 600 150" role="img" aria-label="Altitude along the route"></svg>
          </div></div>
          <div>
            <p class="mono" id="p-nights" style="margin:0 0 4px"></p>
            <ol class="days" id="p-days"></ol>
          </div>
        </div>
      </section>

      <section aria-labelledby="win-h">
        <div class="sec-head"><h3 id="win-h">Book these first</h3><span class="mono">Booking windows</span></div>
        <div class="windows" id="p-windows"></div>
      </section>

      <section aria-labelledby="flights-h">
        <div class="sec-head"><h3 id="flights-h">Flights</h3><span class="mono" id="p-cabin"></span></div>
        <div class="flights" id="p-flights"></div>
        <p class="hint" style="margin-top:10px">Routes and flying times are approximate. In the real version each flight shows live options and prices from a booking partner; here the cost is part of the estimate below.</p>
      </section>

      <section aria-labelledby="todo-h">
        <div class="sec-head"><h3 id="todo-h">Your booking checklist</h3><span class="mono">Tick it off as you go</span></div>
        <div class="progress"><div class="track"><div class="fill" id="todo-fill"></div></div><span id="todo-count"></span></div>
        <div id="p-todo"></div>
        <p class="hint" style="margin-top:10px">Ticked items and references are kept in this browser only. In the app this becomes part of your trip, on every device, and a reminder comes for anything still open as its date gets close.</p>
      </section>

      <section aria-labelledby="budget-h">
        <div class="sec-head"><h3 id="budget-h">Where the budget goes</h3><span class="mono" id="p-budget-basis"></span></div>
        <div style="overflow-x:auto"><table id="p-budget"></table></div>
      </section>

      <section aria-labelledby="incl-h">
        <div class="sec-head"><h3 id="incl-h">What's in this proposal</h3><span class="mono">Advice, not a package</span></div>
        <div class="incl">
          <div class="yes"><h4>We plan for you</h4><ul>
            <li>The route, day by day, with travel times</li>
            <li>Every hotel and restaurant by name, with its MICHELIN Keys and World's 50 Best position</li>
            <li>When to book each table and ticket, with a reminder the day before a window opens</li>
            <li>The flights to look for, and in which cabin</li>
            <li>Transfers, trains and guides to arrange</li>
            <li>Your government's travel advice for every stop, checked again a week before you leave</li>
          </ul></div>
          <div class="no"><h4>You book and pay yourself</h4><ul>
            <li>Flights, hotels and restaurants, directly with each of them</li>
            <li>Machu Picchu entry and the train (we tell you when)</li>
            <li>Travel and cancellation insurance</li>
            <li>Passport and entry requirements for your nationality</li>
            <li>Tips, entrance fees and anything not named above</li>
          </ul></div>
        </div>
      </section>

      <div class="actions">
        <button type="button" class="btn primary" id="ask">Ask for this trip</button>
        <button type="button" class="btn" id="edit">Change my answers</button>
      </div>
      <p class="note" id="asked" hidden>In the real version this sends the proposal to you (the advisor) to check before anything is booked. In this prototype nothing is sent.</p>
    </div>
  </div>
</div>
  </div>
  <script is:inline set:html={`window.OTBT_LINKS = ${JSON.stringify(links)};`}></script>
  <script is:inline>
(() => {
  const STEPS = ['Who', 'Where and when', 'Style', 'Budget', 'The table'];
  const COUNTRIES = ['Peru', 'Chile', 'Argentina', 'Japan', 'Norway', 'Italy', 'South Africa', 'Iceland', 'Mexico', 'Morocco'];
  const STYLES = ['Adventure', 'Luxury', 'Beach', 'Sun', 'Winter sports', 'Nature and wildlife', 'Culture', 'Wine'];
  const ADV = ['', 'Gentle walks and easy days', 'Day hikes, nothing technical', 'Long hikes, the odd early start', 'Demanding days, rough lodges are fine', 'Multi-day treks and remote camps'];
  const NATIONALITIES = ['Dutch', 'Belgian', 'German', 'British', 'American', 'French'];

  const state = { step: 0, countries: new Set(['Peru']), styles: new Set(['Adventure', 'Luxury', 'Nature and wildlife']),
    travellers: [{ name: 'Traveller 1', nat: 'Dutch' }, { name: 'Traveller 2', nat: 'Dutch' }] };
  const $ = (id) => document.getElementById(id);
  const fieldsets = [...document.querySelectorAll('fieldset[data-step]')];

  // stepper
  $('steps').innerHTML = STEPS.map((s, i) => `<li><button type="button" data-go="${i}" aria-label="Step ${i + 1}: ${s}"><span class="bar"></span><span class="lbl">${s}</span></button></li>`).join('');
  $('steps').addEventListener('click', (e) => { const b = e.target.closest('[data-go]'); if (!b) return; const to = +b.dataset.go; if (to < state.step || validate(state.step)) show(to); });

  // chips
  const chipGroup = (el, list, set) => {
    el.innerHTML = list.map((c) => `<button type="button" class="chip" aria-pressed="${set.has(c)}">${c}</button>`).join('');
    el.addEventListener('click', (e) => { const b = e.target.closest('.chip'); if (!b) return; const v = b.textContent;
      set.has(v) ? set.delete(v) : set.add(v); b.setAttribute('aria-pressed', set.has(v)); if (el.id === 'countries') $('countries-err').hidden = true; });
  };
  chipGroup($('countries'), COUNTRIES, state.countries);
  chipGroup($('styles'), STYLES, state.styles);

  // travellers
  const renderTravellers = () => {
    $('travellers').innerHTML = state.travellers.map((t, i) => `
      <div class="traveller">
        <input type="text" id="tname-${i}" aria-label="Traveller ${i + 1} name" value="${t.name}">
        <select id="tnat-${i}" aria-label="Traveller ${i + 1} nationality">${NATIONALITIES.map((n) => `<option ${n === t.nat ? 'selected' : ''}>${n}</option>`).join('')}</select>
      </div>`).join('');
  };
  $('travellers').addEventListener('input', (e) => { const m = e.target.id.match(/^t(name|nat)-(\d+)$/); if (!m) return;
    state.travellers[+m[2]][m[1] === 'name' ? 'name' : 'nat'] = e.target.value; });
  $('add-trav').addEventListener('click', () => { if (state.travellers.length >= 8) return; state.travellers.push({ name: `Traveller ${state.travellers.length + 1}`, nat: 'Dutch' }); renderTravellers(); });
  renderTravellers();

  const advOut = () => { $('adv-out').textContent = ADV[+$('adventure').value]; };
  $('adventure').addEventListener('input', advOut); advOut();
  ['start', 'end'].forEach((id) => $(id).addEventListener('input', () => { $('dates-err').hidden = true; }));
  $('budget').addEventListener('input', () => { $('budget-err').hidden = true; });

  function validate(step) {
    if (step === 1) {
      let ok = true;
      if (state.countries.size === 0) { $('countries-err').hidden = false; ok = false; }
      const s = $('start').value, e = $('end').value;
      if (!s || !e || e <= s) { $('dates-err').hidden = false; ok = false; }
      return ok;
    }
    if (step === 3 && !(+$('budget').value > 0)) { $('budget-err').hidden = false; return false; }
    return true;
  }

  function show(step) {
    state.step = step;
    fieldsets.forEach((f, i) => { f.hidden = i !== step; });
    [...$('steps').children].forEach((li, i) => { li.className = i < step ? 'done' : i === step ? 'on' : ''; });
    $('back').hidden = step === 0;
    $('next').textContent = step === STEPS.length - 1 ? 'Make my proposal' : 'Next';
    $('count').textContent = `${step + 1} of ${STEPS.length}`;
    const first = fieldsets[step].querySelector('input, select, textarea, button');
    if (first && document.activeElement && document.activeElement !== document.body) first.focus({ preventScroll: true });
  }

  $('back').addEventListener('click', () => show(Math.max(0, state.step - 1)));
  $('form').addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validate(state.step)) return;
    if (state.step < STEPS.length - 1) { show(state.step + 1); return; }
    openProposal(false);
    autosave();
  });
  function openProposal(again) {
    renderProposal(again);
    $('intake').hidden = true; $('proposal').hidden = false;
    $('proposal').classList.toggle('editing', state.editing);
    if (!again) { $('save-panel').hidden = true; $('share-panel').hidden = true; window.scrollTo({ top: 0, behavior: 'smooth' }); }
  }
  $('edit').addEventListener('click', () => { stop(); $('proposal').hidden = true; $('intake').hidden = false; $('asked').hidden = true; renderMyTrips(); show(0); window.scrollTo({ top: 0 }); });
  $('ask').addEventListener('click', () => { $('asked').hidden = false; });

  // ---- saved trips (prototype: this browser only) ----
  const FIELDS = ['children', 'occasion', 'from', 'to', 'start', 'end', 'flex', 'adventure', 'pace', 'nogo', 'budget', 'basis', 'flights', 'cabin', 'ground', 'wishlist', 'events', 'diet', 'mobility', 'musts'];
  state.extras = []; state.tripId = null; state.tripName = ''; state.editing = false;
  const uid = () => Math.random().toString(36).slice(2, 9);
  const loadTrips = () => { try { return JSON.parse(localStorage.getItem('otbt-trips') || '[]'); } catch { return []; } };
  const storeTrips = (trips) => { try { localStorage.setItem('otbt-trips', JSON.stringify(trips)); return true; } catch { return false; } };
  function getAnswers() {
    const f = {}; FIELDS.forEach((id) => { const el = $(id); f[id] = el.type === 'checkbox' ? el.checked : el.value; });
    return { fields: f, travellers: state.travellers.map((t) => ({ ...t })), countries: [...state.countries], styles: [...state.styles] };
  }
  function setAnswers(a) {
    FIELDS.forEach((id) => { const el = $(id); if (!(id in a.fields)) return; if (el.type === 'checkbox') el.checked = a.fields[id]; else el.value = a.fields[id]; });
    state.travellers = a.travellers.map((t) => ({ ...t })); renderTravellers();
    state.countries.clear(); a.countries.forEach((c) => state.countries.add(c));
    state.styles.clear(); a.styles.forEach((c) => state.styles.add(c));
    document.querySelectorAll('#countries .chip').forEach((b) => b.setAttribute('aria-pressed', state.countries.has(b.textContent)));
    document.querySelectorAll('#styles .chip').forEach((b) => b.setAttribute('aria-pressed', state.styles.has(b.textContent)));
    advOut();
  }
  function renderMyTrips() {
    const trips = loadTrips();
    $('mytrips').hidden = trips.length === 0;
    $('mytrips').innerHTML = trips.length ? `<p class="eyebrow">Your saved trips</p>` + trips.map((t) => `
      <div class="trip-row" data-id="${t.id}"><span class="name">${esc(t.name)}</span><span class="when">saved ${new Date(t.savedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</span>
        <button type="button" class="linkbtn" data-act="open">Open</button><button type="button" class="linkbtn danger" data-act="del">Delete</button></div>`).join('') : '';
  }
  $('mytrips').addEventListener('click', (e) => {
    const b = e.target.closest('[data-act]'); if (!b) return;
    const row = b.closest('.trip-row'); const id = row.dataset.id;
    if (b.dataset.act === 'del') {
      if (b.dataset.sure) { storeTrips(loadTrips().filter((t) => t.id !== id)); try { localStorage.removeItem('otbt-todo-' + id); } catch {} renderMyTrips(); }
      else { b.dataset.sure = '1'; b.textContent = 'Delete for good?'; }
      return;
    }
    const t = loadTrips().find((x) => x.id === id); if (!t) return;
    setAnswers(t.answers); state.extras = t.extras || []; state.tripId = t.id; state.tripName = t.name;
    openProposal(false);
    $('save-status').textContent = `Saved as “${t.name}”`;
  });
  function saveTrip(name) {
    const trips = loadTrips();
    const id = state.tripId || uid();
    const entry = { id, name, savedAt: Date.now(), answers: getAnswers(), extras: state.extras };
    const i = trips.findIndex((t) => t.id === id);
    if (i >= 0) trips[i] = entry; else trips.unshift(entry);
    // move this draft's checklist under the trip's own key
    if (!state.tripId) { try { const draft = localStorage.getItem('otbt-todo-draft'); if (draft) localStorage.setItem('otbt-todo-' + id, draft); } catch {} }
    state.tripId = id; state.tripName = name;
    const ok = storeTrips(trips);
    $('save-status').textContent = ok ? `Saved as “${name}”` : 'This browser won’t keep it. In the app it would be saved to your account.';
    renderMyTrips();
  }
  const autosave = () => { if (state.tripId) saveTrip(state.tripName); };

  $('save-btn').addEventListener('click', () => {
    $('share-panel').hidden = true;
    $('save-panel').hidden = !$('save-panel').hidden;
    if (!$('save-panel').hidden) { $('trip-name').value = state.tripName || `Peru, ${fmt(d($('start').value))}`; $('trip-name').focus(); }
