    { from: 'lima', to: 'valley', mode: 'Flight + drive', time: 'about 3 h', text: 'Fly Lima to Cusco, then drive down into the valley, 500 m lower than the city and gentler for the first Andean nights.' },
    { from: 'valley', to: 'mp', mode: 'Train', time: 'about 1 h 30 to 2 h', text: 'The train from Ollantaytambo along the Urubamba to Machu Picchu.', train: true, bend: 0.35 },
    { from: 'mp', to: 'valley', mode: 'Train', time: 'about 1 h 30 to 2 h', text: 'Back up the river by train the same evening.', train: true, bend: 0.35 },
    { from: 'valley', to: 'cusco', mode: 'Drive', time: 'about 1 h 30', text: 'Up to Cusco for three nights, the highest point of the trip.' },
    { from: 'cusco', to: 'lima', mode: 'Flight', time: 'about 1 h 20', text: 'Back down to the coast for a last two nights at the table.' },
  ];

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SVGNS = 'http://www.w3.org/2000/svg';
  // The three Andean stops sit within 25 px of each other at country
  // scale, so they are drawn again in a magnifying inset over the ocean.
  const LOUPE = { cx: 150, cy: 662, r: 116, center: [-72.21, -13.34], k: 270 };
  const inLoupe = (key) => key !== 'lima';
  const loupeXY = (key) => { const [lon, lat] = STOP[key].ll; return [LOUPE.cx + (lon - LOUPE.center[0]) * LOUPE.k * 0.97, LOUPE.cy - (lat - LOUPE.center[1]) * LOUPE.k]; };
  const xy = (key, preferLoupe) => preferLoupe && inLoupe(key) ? loupeXY(key) : STOP[key].at;
  const curve = (a, b, bend) => { const mx = (a[0] + b[0]) / 2, my = (a[1] + b[1]) / 2; const dx = b[0] - a[0], dy = b[1] - a[1];
    return `M${a[0]} ${a[1]} Q${mx - dy * bend} ${my + dx * bend} ${b[0]} ${b[1]}`; };
  const legPath = (leg) => {
    if (inLoupe(leg.from) && inLoupe(leg.to)) return { d: curve(loupeXY(leg.from), loupeXY(leg.to), leg.bend ?? 0.25), loupe: true };
    return { d: curve(STOP[leg.from].at, STOP[leg.to].at, leg.from === 'lima' ? -0.18 : -0.22), loupe: false };
  };

  function renderMap() {
    const m = $('map');
    [...m.querySelectorAll(':scope > :not(title)')].forEach((n) => n.remove());
    const nb = ['Ecuador', 'Colombia', 'Brazil', 'Bolivia', 'Chile'].map((n) => `<path class="country nb" d="${GEO[n]}"/>`).join('');
    const labels = [['ECUADOR', 120, 40], ['COLOMBIA', 420, 30], ['BRAZIL', 540, 330], ['BOLIVIA', 545, 640], ['CHILE', 525, 778], ['PACIFIC OCEAN', 40, 400], ['AMAZON', 380, 230]]
      .map(([t, x, y]) => `<text class="lbl" x="${x}" y="${y}">${t}</text>`).join('');
    const [lx, ly] = STOP.lima.at;
    const region = STOP.valley.at;
    const ghosts = LEGS.map((l) => { const p = legPath(l); return `<path class="ghost" d="${p.d}"/>`; }).join('');
    const legs = LEGS.map((l, i) => { const p = legPath(l); return `<path class="leg${l.train ? ' train' : ''}" id="leg-${i}" d="${p.d}"/>`; }).join('');
    const loupeStops = ['valley', 'cusco', 'mp'].map((k) => { const [x, y] = loupeXY(k);
      // Label placement per stop, kept inside the inset circle.
      const lp = { valley: [10, 24, 'start'], cusco: [0, 26, 'middle'], mp: [12, -12, 'start'] }[k];
      return `<circle class="stop" data-stop="${k}" cx="${x}" cy="${y}" r="7"/><text class="stop-lbl" x="${x + lp[0]}" y="${y + lp[1]}" text-anchor="${lp[2]}">${STOP[k].name}</text>`; }).join('');
    m.insertAdjacentHTML('beforeend', `
      ${nb}<path class="peru" d="${GEO.Peru}"/>${labels}
      <line x1="${region[0]}" y1="${region[1]}" x2="${LOUPE.cx + LOUPE.r * 0.72}" y2="${LOUPE.cy - LOUPE.r * 0.69}" stroke="var(--ink)" stroke-width="0.8"/>
      <circle cx="${region[0] + 4}" cy="${region[1] + 2}" r="16" fill="none" stroke="var(--ink)" stroke-width="0.8"/>
      <defs><clipPath id="loupe-clip"><circle cx="${LOUPE.cx}" cy="${LOUPE.cy}" r="${LOUPE.r}"/></clipPath></defs>
      <circle class="loupe-bg" cx="${LOUPE.cx}" cy="${LOUPE.cy}" r="${LOUPE.r}"/>
      <text class="lbl" x="${LOUPE.cx}" y="${LOUPE.cy + LOUPE.r - 16}" text-anchor="middle">SACRED VALLEY AND CUSCO</text>
      ${ghosts}${legs}
      <circle class="stop" data-stop="lima" cx="${lx}" cy="${ly}" r="7"/>
      <text class="stop-lbl" x="${lx - 14}" y="${ly + 5}" text-anchor="end">Lima</text>
      <g clip-path="url(#loupe-clip)">${loupeStops}</g>
      <circle class="loupe-ring" cx="${LOUPE.cx}" cy="${LOUPE.cy}" r="${LOUPE.r}"/>
      <circle class="marker" id="marker" r="7" cx="${lx}" cy="${ly}"/>`);
    LEGS.forEach((_, i) => { const el = $('leg-' + i); const len = el.getTotalLength(); el.style.strokeDasharray = el.classList.contains('train') ? '' : `${len}`; el.dataset.len = len; el.style.strokeDashoffset = el.classList.contains('train') ? '0' : `${len}`; el.style.opacity = '0'; });
  }

  function renderAltitude() {
    const order = ['lima', 'valley', 'mp', 'cusco', 'lima'];
    const W = 600, H = 150, top = 22, bottom = 118, max = 4500;
    const x = (i) => 40 + i * ((W - 80) / (order.length - 1));
    const y = (m) => bottom - (m / max) * (bottom - top);
    const pts = order.map((k, i) => [x(i), y(STOP[k].alt)]);
    const line = pts.map((p, i) => `${i ? 'L' : 'M'}${p[0]} ${p[1]}`).join(' ');
    const limit = $('nogo').value.toLowerCase().includes('altitude');
    $('alt').innerHTML = `
      <path d="${line} L${pts[pts.length - 1][0]} ${bottom} L${pts[0][0]} ${bottom} Z" fill="var(--land)"/>
      <path d="${line}" fill="none" stroke="var(--route)" stroke-width="1.6"/>
      <line x1="30" x2="${W - 30}" y1="${y(4000)}" y2="${y(4000)}" stroke="${limit ? 'var(--error)' : 'var(--muted)'}" stroke-dasharray="4 4" stroke-width="1"/>
      <text x="${W - 30}" y="${y(4000) - 6}" text-anchor="end">${limit ? 'YOUR LIMIT · 4,000 M' : '4,000 M'}</text>
      ${pts.map((p, i) => `<circle cx="${p[0]}" cy="${p[1]}" r="3.5" fill="var(--route)"/>
        <text class="name" x="${p[0]}" y="${bottom + 18}" text-anchor="middle">${STOP[order[i]].name}</text>
        <text x="${p[0]}" y="${p[1] - 8}" text-anchor="middle">~${STOP[order[i]].alt.toLocaleString('en-GB')} M</text>`).join('')}`;
  }

  function highlight(stopKey) {
    document.querySelectorAll('#map .stop').forEach((c) => c.classList.toggle('on', c.dataset.stop === stopKey));
  }
  function setMarker(stopKey) {
    const [x, y] = xy(stopKey, true);
    const mk = $('marker'); mk.setAttribute('cx', x); mk.setAttribute('cy', y);
  }
  function showLegsUpTo(n) {
    LEGS.forEach((_, i) => { const el = $('leg-' + i); el.style.opacity = i <= n ? '1' : '0'; if (!el.classList.contains('train')) el.style.strokeDashoffset = i <= n ? '0' : el.dataset.len; });
  }
  function caption(day) {
    const leg = day.leg ? LEGS[day.leg[0]] : null;
    $('caption').innerHTML = `<strong>${day.t}.</strong> ${leg ? `${leg.mode}, ${leg.time}. ${leg.text}` : `${STOP[day.stop].name}, about ${STOP[day.stop].alt.toLocaleString('en-GB')} m.`}`;
  }
  function focusDay(i, quiet) {
    const day = state.plan[i]; if (!day) return;
    document.querySelectorAll('#p-days .day').forEach((li) => li.classList.toggle('on', +li.dataset.i === i));
    const lastLeg = Math.max(-1, ...state.plan.slice(0, i + 1).flatMap((d) => d.leg ?? [-1]));
    showLegsUpTo(lastLeg); highlight(day.stop); setMarker(day.stop); caption(day);
  }
  function wireDays() {
    const list = $('p-days');
    list.onclick = (e) => {
      const add = e.target.closest('.add-place');
      if (add) { const holder = add.parentElement.querySelector('.form-holder'); holder.innerHTML = holder.innerHTML ? '' : placeForm(add.dataset.day); holder.querySelector('input[name=name]')?.focus(); return; }
      const rm = e.target.closest('.rm');
      if (rm) { state.extras = state.extras.filter((x) => x.id !== rm.dataset.id); autosave(); openProposal(true); return; }
      if (e.target.closest('[data-cancel]')) { e.target.closest('.form-holder').innerHTML = ''; return; }
      if (e.target.closest('button, input, select, a, form')) return;
      const li = e.target.closest('.day'); if (li) { stop(); focusDay(+li.dataset.i); } };
    list.onsubmit = (e) => {
      e.preventDefault();
      const f = e.target; const data = Object.fromEntries(new FormData(f));
      if (!data.name.trim()) { f.querySelector('.error').hidden = false; return; }
      const url = /^https?:\/\//i.test(data.url.trim()) ? data.url.trim() : '';
      state.extras.push({ id: uid(), day: +f.dataset.day, kind: data.kind, name: data.name.trim(), city: data.city.trim(), url, note: data.note.trim() });
      autosave(); openProposal(true);
    };
    list.onkeydown = (e) => { if ((e.key === 'Enter' || e.key === ' ') && e.target.classList.contains('day')) { e.preventDefault(); stop(); focusDay(+e.target.dataset.i); } };
  }

  // Play: each leg draws itself while the marker travels along it.
  let playing = null;
  function stop() { if (playing) { cancelAnimationFrame(playing); playing = null; $('play').textContent = 'Play the journey'; } }
  function play() {
    if (playing) { stop(); return; }
    if (reduce) { focusDay(state.plan.length - 1); return; }
    $('play').textContent = 'Pause';
    const seq = []; // [dayIndex, legIndex|null]
    state.plan.forEach((d, i) => (d.leg ?? [null]).forEach((l) => seq.push([i, l])));
    focusDay(0);
    let k = 0, t0 = null;
    const DWELL = 900, TRAVEL = 1800;
    const step = (ts) => {
      if (t0 === null) t0 = ts;
      const [di, li] = seq[k];
      const dur = li === null ? DWELL : TRAVEL;
      const f = Math.min(1, (ts - t0) / dur);
      if (li !== null) {
        const el = $('leg-' + li), len = +el.dataset.len;
        el.style.opacity = '1';
        if (!el.classList.contains('train')) el.style.strokeDashoffset = `${len * (1 - f)}`;
        const pt = el.getPointAtLength(len * f);
        const mk = $('marker'); mk.setAttribute('cx', pt.x); mk.setAttribute('cy', pt.y);
        if (f === 1) focusDay(di);
      } else if (t0 === ts) focusDay(di);
      if (f < 1) { playing = requestAnimationFrame(step); return; }
      k += 1; t0 = null;
      if (k < seq.length) playing = requestAnimationFrame(step); else { playing = null; $('play').textContent = 'Play again'; }
    };
    playing = requestAnimationFrame(step);
  }
  $('play').addEventListener('click', play);

  function renderProposal(again) {
    const start = d($('start').value), end = d($('end').value);
    const nights = Math.round((end - start) / 86400000);
    const people = state.travellers.length + (+$('children').value || 0);
    const budgetIn = +$('budget').value;
    const total = $('basis').value === 'pp' ? budgetIn * people : budgetIn;
    const names = state.travellers.map((t) => t.name.trim()).filter(Boolean);
    const nats = [...new Set(state.travellers.map((t) => t.nat))];

    $('p-kicker').textContent = `${$('occasion').value === 'No particular occasion' ? 'A proposal' : $('occasion').value} · ${fmtY(start)} – ${fmtY(end)}`;
    $('p-intro').textContent = `${nights} nights for ${names.join(' and ') || 'you'}: three nights of Lima's tables, the Sacred Valley on foot at your pace, and a cloud forest lodge with no road to it. The route stays below 4,000 m${$('nogo').value.toLowerCase().includes('altitude') ? ', as you asked' : ''}.`;

    const flexTxt = { fixed: 'Exact dates', 3: '± 3 days', 7: '± 1 week', month: 'Any time that month' }[$('flex').value];
    $('p-facts').innerHTML = [
      ['Travellers', `${people} ${people === 1 ? 'person' : 'people'}`],
      ['Dates', `${fmt(start)} – ${fmt(end)}`],
      ['Flexibility', flexTxt],
      ['Budget', `${eur(total)} total`],
      ['From / to', `${esc($('from').value)} → ${esc($('to').value)}`],
    ].map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join('');

    // travel advice: one block per nationality (illustrative colours)
    const ADVICE = [
      { c: 'var(--adv-yellow)', t: 'Yellow', who: 'Lima, Cusco, Sacred Valley', note: 'Security risks; take normal precautions. On the route.' },
      { c: 'var(--adv-yellow)', t: 'Yellow', who: 'Cloud forest region', note: 'On the route.' },
      { c: 'var(--adv-orange)', t: 'Orange', who: 'VRAEM valley and border areas', note: 'Only necessary travel. The route stays out of these areas; many policies cover less here.' },
    ];
    $('p-advice').innerHTML = nats.map((n) => `
      <p class="eyebrow" style="margin-top:4px">${n} travellers · ${n === 'Dutch' ? 'Nederland Wereldwijd' : 'own government'} · checked ${fmtY(new Date(Date.UTC(2026, 10, 16)))} (example)</p>
      ${ADVICE.map((a) => `<div class="adv-row"><span class="dot" style="background:${a.c}"></span><div><strong>${a.who}</strong><p>${a.note}</p></div><span class="tag" style="color:${a.c}">${a.t}</span></div>`).join('')}
    `).join('') + `<p class="hint" style="margin-top:6px">Check what your travel insurance covers for each colour. We check the advice again a week before you leave and tell you if it changes.</p>`;

    // ---- the journey: map, altitude, days ----
    renderMap();
    renderAltitude();
    // Venues: real catalogue rows (MICHELIN Keys, World's 50 Best 2026 as held).
    const H = (name, city, keys) => ['Hotel', `${name} · ${city}`, `<span class="gold">${keys} MICHELIN Key${keys === 1 ? '' : 's'}</span>`];
    // Restaurants carry their catalogue code; the site links them to their page.
    const LINKS = window.OTBT_LINKS || {};
    const R = (when, name, mark, code) => [when, LINKS[code] ? `<a href="${LINKS[code]}">${name}</a>` : name, mark];
    const plan = [
      { off: 0, stop: 'lima', t: 'Arrive in Lima', p: `Overnight flight from ${esc($('from').value)}; a driver meets you. Three nights by the sea in Barranco.`, items: [H('Hotel B', 'Lima', 1)] },
      { off: 1, stop: 'lima', t: 'Lima at the table', p: 'Market walk in the morning, then the two meals this trip is built around.', items: [R('Lunch', 'Mayta · Lima', 'The 50 Best #45', 'rest_0141'), R('Dinner', 'Central · Lima', 'The 50 Best Hall of Fame', 'rest_1578')] },
      { off: 2, stop: 'lima', t: 'Lima, slowly', p: 'A free day along the Malecón, with one more serious dinner.', items: [R('Dinner', 'Kjolle · Lima', 'The 50 Best #7', 'rest_0135')] },
      { off: 3, stop: 'valley', leg: [0], t: 'Into the Sacred Valley', p: 'Three nights low in the valley before the altitude of Cusco.', items: [H('Inkaterra Hacienda Urubamba', 'Sacred Valley', 2)] },
      { off: 4, stop: 'valley', t: 'A day on foot', p: `${ADV[+$('adventure').value]}. A guide sets the pace; nothing above 4,000 m. Lunch at the edge of the Moray terraces.`, items: [R('Lunch', 'Mil · Cusco region', 'The 50 Best #95', 'rest_1381')] },
      { off: 5, stop: 'mp', leg: [1, 2], t: 'Machu Picchu', p: 'Out on the morning train, a guided visit, back to the valley for dinner. Entry tickets are limited: the first thing to book.', items: [] },
      { off: 6, stop: 'cusco', leg: [3], t: 'Cusco', p: 'Three nights in the old town, the highest point of the trip at about 3,400 m.', items: [H('Inkaterra La Casona', 'Cusco', 2)] },
      { off: 7, stop: 'cusco', t: 'Cusco, on your own time', p: 'San Blas, the Inca walls, a slow afternoon. Kept free on purpose.', items: [] },
      { off: 9, stop: 'lima', leg: [4], t: 'Back to Lima', p: 'Two last nights on the coast, at a different hotel.', items: [H('Atemporal by Andean', 'Lima', 1), R('Dinner', 'Mérito · Lima', 'The 50 Best #13', 'rest_0139')] },
      { off: 10, stop: 'lima', t: 'A last lunch, and home', p: `Lunch, then the evening flight to ${esc($('to').value)}.`, items: [R('Lunch', 'Maido · Lima', 'The 50 Best Hall of Fame', 'rest_0134')] },
    ];
    const scale = Math.max(1, nights) / 11;
    const extrasFor = (i) => state.extras.filter((x) => x.day === i);
    $('p-nights').textContent = `${nights} nights · 3 bases and a day at Machu Picchu · tap a day to see it on the map`;
    $('p-days').innerHTML = plan.map((day, i) => {
      const dt = add(start, Math.min(nights, Math.round(day.off * scale)));
      const legs = (day.leg ?? []).map((n) => LEGS[n]);
      return `<li class="day" data-i="${i}" data-stop="${day.stop}" tabindex="0"><span class="when">${fmt(dt).toUpperCase()}</span><div>
        <h4><span class="pin" aria-hidden="true"></span>${day.t}</h4>
        ${legs.map((leg) => `<div class="leg-row"><span class="mode">${leg.mode}</span><span>${STOP[leg.from].name} → ${STOP[leg.to].name}, ${leg.time} (approx.)</span></div>`).join('')}
        <p>${day.p}</p>
        ${day.items.length ? `<div class="items">${day.items.map(([k, v, m]) => `<div class="item"><span class="kind">${k}</span><span>${v}</span>${m ? `<span class="est">${m}</span>` : ''}</div>`).join('')}</div>` : ''}
        ${extrasFor(i).length ? `<div class="items">${extrasFor(i).map((x) => `<div class="extra"><span class="kind">${esc(x.kind)}</span><span>${x.url ? `<a href="${esc(x.url)}" target="_blank" rel="noopener">${esc(x.name)}</a>` : esc(x.name)}${x.city ? ` · ${esc(x.city)}` : ''}</span><span class="mine">Added by you</span>${x.note ? `<span class="est">${esc(x.note)}</span>` : ''}<button type="button" class="linkbtn danger rm" data-id="${x.id}">Remove</button></div>`).join('')}</div>` : ''}
        <button type="button" class="chip add-place" data-day="${i}">+ Add a place not in Mantelier</button>
        <div class="form-holder"></div></div></li>`;
    }).join('');
    state.plan = plan;
    wireDays();
    focusDay(0, true);
    if (!reduce && !again) setTimeout(() => play(), 500);

    // booking timeline: no restaurant window is known yet, so none is
    // invented. Each says so, and what happens once it is known.
    const plain = (v) => v.replace(/<[^>]+>/g, '');
    const tables = plan.flatMap((d, i) => d.items.filter(([k]) => k === 'Lunch' || k === 'Dinner').map(([k, v, m]) => ({ when: add(start, Math.min(nights, Math.round(d.off * scale))), meal: k, name: plain(v).split(' · ')[0], mark: m })));
    $('p-windows').innerHTML = `
      <div class="win"><strong>Machu Picchu entry and train · ${fmtY(add(start, Math.round(5 * scale)))}</strong><span class="mono">book first</span>
        <p>Daily entry is capped and sells out in the dry season. Book as soon as the dates are fixed; the rest of the route can move around it.</p></div>
      ${tables.map((t) => `<div class="win unknown"><strong>${t.name} · ${t.meal.toLowerCase()} ${fmtY(t.when)}</strong><span class="mono">window not known yet</span>
        <p>${t.mark}. We don't hold this restaurant's booking window yet, so we won't guess one. We check its own booking page before you book, and from then on you get a reminder the day before it opens.</p></div>`).join('')}`;

    // flights
    $('p-cabin').textContent = $('cabin').value;
    const from = esc($('from').value), to = esc($('to').value);
    const direct = (c) => /amsterdam/i.test(c);
    const flights = [
      [direct(from) ? 'AMS – LIM' : `${from.slice(0, 3).toUpperCase()} – LIM`, `${from} to Lima`, fmtY(start), direct(from) ? 'Direct flights exist on this route, about 13 h. Arrives the same evening.' : 'One stop via a European hub, about 15–17 h.'],
      ['LIM – CUZ', 'Lima to Cusco', fmtY(add(start, Math.round(3 * scale))), 'About 1 h 20, morning flights. Then the drive down to the valley.'],
      ['CUZ – LIM', 'Cusco to Lima', fmtY(add(start, Math.round(9 * scale))), 'About 1 h 20.'],
      [direct(to) ? 'LIM – AMS' : `LIM – ${to.slice(0, 3).toUpperCase()}`, `Lima to ${to}`, fmtY(add(start, Math.min(nights, Math.round(10 * scale)))), 'Evening departure, overnight, home the next afternoon.'],
    ];
    $('p-flights').innerHTML = flights.map(([code, what, when, meta]) => `<div class="flight"><span class="route-code">${code}</span><span class="what">${what}</span><span class="mono">${when}</span><p class="meta">${meta}</p></div>`).join('');

    // booking checklist: everything to book, in the order to book it,
    // with where the confirmation will turn up.
    const T = (id, group, title, date, where, first) => ({ id, group, title, date, where, first });
    const stayEnd = (from, n) => add(start, Math.min(nights, Math.round((from + n) * scale)));
    const todos = [
      T('mp', 'Book first', 'Machu Picchu entry tickets', fmtY(add(start, Math.round(5 * scale))), 'Ticket PDF from the official Machu Picchu ticket site, by email. Bring it on your phone and printed.', true),
      T('train', 'Book first', 'Train Ollantaytambo – Machu Picchu, return', fmtY(add(start, Math.round(5 * scale))), 'E-ticket from the train operator, by email; show it with your passport.', true),
      T('ins', 'Before you book', 'Travel and cancellation insurance', 'Before booking anything', 'Policy document from your insurer. Check that every stop on the route is covered for its travel-advice colour.', false),
      T('entry', 'Before you book', 'Passport valid long enough, entry rules checked', 'Before booking flights', 'Your own passport. Entry rules on your government’s travel-advice page for Peru.', false),
      ...flights.map(([code, what, when], i) => T('fl' + i, 'Flights', `${what} (${code})`, when, i === 0 || i === 3 ? 'Confirmation email from the airline: six-character booking code. Seats and luggage in the airline’s app.' : 'Confirmation email from the airline: booking code. Check the luggage allowance, often lower on domestic flights.', false)),
      ...plan.flatMap((d) => d.items.filter(([k]) => k === 'Hotel').map(([, v]) => ({ d, name: v.split(' · ')[0] })))
        .map(({ d, name }, i, arr) => T('h' + i, 'Hotels', name, `${fmt(add(start, Math.round(d.off * scale)))} – ${fmtY(stayEnd(d.off, (arr[i + 1]?.d.off ?? 11) - d.off))}`, 'Confirmation email from the hotel: reservation number and cancellation terms. Ask them for the airport or station transfer in the same email.', false)),
      ...tables.map((t, i) => T('r' + i, 'Restaurants', `${t.name} · ${t.meal.toLowerCase()}`, fmtY(t.when), 'Confirmation email or text from the restaurant or its booking system. Note the deposit and how late you can cancel.', false)),
      ...state.extras.map((x) => T('x' + x.id, x.kind === 'Hotel' ? 'Hotels' : x.kind === 'Restaurant' ? 'Restaurants' : 'On the ground', `${x.name}${x.city ? ' · ' + x.city : ''}`, fmtY(add(start, Math.round(plan[x.day].off * scale))), 'Your own confirmation. Not in Mantelier, so add the reference here to keep everything in one place.', false)),
      T('drv', 'On the ground', 'Driver Cusco airport – Sacred Valley, and the transfers in Lima', fmtY(add(start, Math.round(3 * scale))), 'Driver’s name and phone number from the hotel or agency, by email or WhatsApp.', false),
      T('guide', 'On the ground', 'Guide for Machu Picchu and the day on foot', fmtY(add(start, Math.round(4 * scale))), 'Meeting point and time, by email from the guide or the hotel.', false),
    ];
    let saved = {};
    const todoKey = 'otbt-todo-' + (state.tripId || 'draft');
    try { saved = JSON.parse(localStorage.getItem(todoKey) || '{}'); } catch { saved = {}; }
    const groups = [...new Set(todos.map((t) => t.group))];
    $('p-todo').innerHTML = groups.map((g) => `<div class="check-group"><h4>${g}</h4>${todos.filter((t) => t.group === g).map((t) => {
      const st = saved[t.id] || {};
      return `<div class="todo${st.done ? ' done' : ''}" data-id="${t.id}">
        <input type="checkbox" id="todo-${t.id}" ${st.done ? 'checked' : ''}>
        <label for="todo-${t.id}"><span class="t">${esc(t.title)}</span><span class="d">${t.date}</span>${t.first ? '<span class="first">Book first</span>' : ''}</label>
        <p class="where">${t.where}</p>
        <div class="ref"><input type="text" id="ref-${t.id}" aria-label="Booking reference or note for ${esc(t.title)}" placeholder="Booking reference, or where you saved it" value="${esc(st.ref || '')}"></div>
      </div>`; }).join('')}</div>`).join('');
    const updateCount = () => {
      const done = todos.filter((t) => $('todo-' + t.id).checked).length;
      $('todo-count').textContent = `${done} of ${todos.length} booked`;
      $('todo-fill').style.width = `${(done / todos.length) * 100}%`;
    };
    const persist = () => {
      const out = {};
      todos.forEach((t) => { out[t.id] = { done: $('todo-' + t.id).checked, ref: $('ref-' + t.id).value }; });
      try { localStorage.setItem(todoKey, JSON.stringify(out)); } catch { /* fine without */ }
    };
    $('p-todo').onchange = (e) => { const row = e.target.closest('.todo'); if (!row) return;
      if (e.target.type === 'checkbox') { row.classList.toggle('done', e.target.checked); if (e.target.checked) $('ref-' + row.dataset.id).focus(); }
      updateCount(); persist(); };
    $('p-todo').oninput = (e) => { if (e.target.id?.startsWith('ref-')) persist(); };
    updateCount();

    // summary for WhatsApp and email
    state.summary = [
      `${state.tripName || 'Peru, from Lima’s tables to the Sacred Valley'}`,
      `${fmtY(start)} – ${fmtY(end)} · ${people} ${people === 1 ? 'traveller' : 'travellers'}`,
      '',
      ...plan.map((day, i) => {
        const dt = add(start, Math.min(nights, Math.round(day.off * scale)));
        const bits = [...day.items.filter(([k]) => k !== 'Why').map(([k, v]) => `${k}: ${v.replace(/<[^>]+>/g, '').split(' · ')[0]}`), ...extrasFor(i).map((x) => `${x.kind}: ${x.name}`)];
        return `${fmt(dt)} · ${day.t}${bits.length ? '\n   ' + bits.join('\n   ') : ''}`;
      }),
      '',
      'Planned with Mantelier',
    ].join('\n');

    // budget: shares of the total, flights optional
    const lines = [
      ['International flights', $('flights').checked ? 0.30 : 0, $('cabin').value],
      ['Hotels', 0.38, `${nights} nights, MICHELIN Key hotels throughout`],
      ['Restaurants and wine', 0.12, 'six restaurants from The World\'s 50 Best'],
      ['Domestic flights, trains, drivers and guides', 0.12, $('ground').value],
      ['Machu Picchu and other entries', 0.05, ''],
      ['Margin for the unexpected', 0.03, ''],
    ].filter((l) => l[1] > 0);
    const share = lines.reduce((s, l) => s + l[1], 0);
    const rows = lines.map(([k, f, note]) => [k, total * f / share, note]);
    const sum = rows.reduce((s, r) => s + r[1], 0);
    $('p-budget-basis').textContent = $('basis').value === 'pp' ? `${eur(budgetIn)} per person × ${people}` : 'Total for everyone';
    $('p-budget').innerHTML = `<thead><tr><th>Part</th><th class="num">Estimate</th></tr></thead>
      <tbody>${rows.map(([k, v, note]) => `<tr><td>${k}${note ? `<br><span class="est">${esc(note)}</span>` : ''}</td><td class="num">${eur(v)} <span class="est">est.</span></td></tr>`).join('')}</tbody>
      <tfoot><tr><td>Total, ${people} ${people === 1 ? 'person' : 'people'}${$('flights').checked ? ', flights included' : ''}</td><td class="num">${eur(sum)}</td></tr>
        <tr><td>Per person</td><td class="num">${eur(sum / people)}</td></tr></tfoot>`;
  }

  renderMyTrips();
  show(0);
})();
</script>
</Base>

