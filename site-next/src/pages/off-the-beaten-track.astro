  $('share-btn').addEventListener('click', () => {
    $('save-panel').hidden = true;
    $('share-panel').hidden = !$('share-panel').hidden;
    if ($('share-panel').hidden) return;
    const text = state.summary || '';
    $('summary').textContent = text;
    $('share-wa').href = 'https://wa.me/?text=' + encodeURIComponent(text);
    $('share-mail').href = 'mailto:?subject=' + encodeURIComponent(state.tripName || 'Our Peru trip') + '&body=' + encodeURIComponent(text);
  });
  $('copy-summary').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText($('summary').textContent); $('copy-summary').textContent = 'Copied'; }
