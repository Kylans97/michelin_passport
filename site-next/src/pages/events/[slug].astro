---
import Base from '../../layouts/Base.astro';
import SaveControls from '../../components/SaveControls.astro';
import { formatWhen, loadEvents, place, type LinkRole, type SiteEvent } from '../../lib/events';

export async function getStaticPaths() {
  const events = await loadEvents();
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props { event: SiteEvent; }
const { event: e } = Astro.props;

const roleLabel = (roles: LinkRole[]) =>
  roles.map((r) => (r === 'host' ? 'Host' : r === 'venue' ? 'Venue' : 'Taking part')).join(' and ');
const where = [e.venueName, place(e)].filter(Boolean).join(', ');
const description = `${e.type} · ${formatWhen(e)}${where ? ` · ${where}` : ''}`;
---
<Base title={e.name} description={description} current="events">
  <article class="wrap">
    <header class="head">
      <p class="eyebrow">{[e.type, ...e.tags].join(' · ')}</p>
      <h1 class="display">{e.name}</h1>
      {e.cancelled && <p class="cancelled">Cancelled</p>}
    </header>

    <dl class="facts">
      <div>
        <dt>When</dt>
        <dd>{formatWhen(e)}</dd>
        {e.startTime && e.city && <dd class="sub">Local time in {e.city}</dd>}
      </div>
      {where && (
        <div>
          <dt>Where</dt>
          <dd>{where}</dd>
          {e.address && <dd class="sub">{e.address}</dd>}
        </div>
      )}
      <div>
        <dt>Admission</dt>
        <dd>{e.admission}</dd>
        {e.admissionNote && <dd class="sub">{e.admissionNote}</dd>}
      </div>
    </dl>

    {!e.cancelled && (
      <div class="actions">
        <SaveControls type="event" id={e.id} appLabel="Mark as Going in the app" variant="solid" event={e} />
        {e.ticketUrl && <a class="link" href={e.ticketUrl} rel="noopener">Tickets →</a>}
        {e.officialUrl && <a class="link" href={e.officialUrl} rel="noopener">Event website →</a>}
      </div>
    )}

    {e.description && (
      <section class="about">
        {e.description.split(/\n\s*\n/).map((p) => <p>{p.trim()}</p>)}
      </section>
    )}

    {e.venues.length > 0 && (
      <section class="venues" aria-labelledby="at-this-event">
        <h2 class="eyebrow" id="at-this-event">At this event</h2>
        {e.venues.map((v) => (
          <div class="venue">
            <p class="display venue-name">{v.href ? <a href={v.href}>{v.name}</a> : v.name}</p>
            <p class="venue-meta">{v.kind} · {roleLabel(v.roles)}</p>
          </div>
        ))}
      </section>
    )}

    <p class="back"><a href="/events">All events →</a></p>
  </article>
</Base>

<style>
  .head { padding-top: 56px; padding-bottom: 28px; max-width: 820px; }
  h1 { font-size: clamp(34px, 4.8vw, 54px); margin-top: 12px; }
  .cancelled { display: inline-block; margin: 14px 0 0; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; border: 1px solid var(--green); padding: 3px 10px; border-radius: 999px; }

  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 20px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); max-width: 900px; }
  dt { font-size: 10px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--taupe); }
  dd { margin: 6px 0 0; font-family: var(--display); font-size: 21px; line-height: 1.3; }
  dd.sub { font-family: var(--body); font-size: 13px; color: var(--ink-soft); margin-top: 4px; }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 24px; font-size: 14px; }
  .link { text-decoration: underline; text-underline-offset: 3px; }

  .about { max-width: 680px; margin-top: 40px; }
  .about p { font-family: var(--display); font-size: 20px; line-height: 1.6; margin: 0 0 18px; white-space: pre-line; }

  .venues { max-width: 680px; margin-top: 40px; display: flex; flex-direction: column; gap: 10px; }
  .venue { background: var(--paper); border: 1px solid var(--rule); border-radius: 6px; padding: 14px 18px; }
  .venue-name { font-size: 22px; }
  .venue-name a { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .venue-meta { font-size: 13px; color: var(--ink-soft); margin: 2px 0 0; }

  .back { margin-top: 40px; font-size: 14px; color: var(--ink-soft); }

  @media (max-width: 760px) {
    .head { padding-top: 36px; }
    .facts { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  }
</style>
