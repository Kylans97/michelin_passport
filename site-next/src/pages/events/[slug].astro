---
import Base from '../../layouts/Base.astro';
import SaveControls from '../../components/SaveControls.astro';
import { dateFigure, formatWhen, loadEvents, place, type LinkRole, type SiteEvent } from '../../lib/events';

export async function getStaticPaths() {
  const events = await loadEvents();
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props { event: SiteEvent; }
const { event: e } = Astro.props;

const roleLabel = (roles: LinkRole[]) =>
  roles.map((r) => (r === 'host' ? 'Host' : r === 'venue' ? 'Venue' : 'Taking part')).join(' and ');
const where = [e.venueName, place(e)].filter(Boolean).join(', ');
const description = `${e.type} · ${formatWhen(e)}${where ? ` · ${where}` : ''}`;
const host = e.venues.find((v) => v.roles.includes('host'));
const byline = [host ? `Hosted by ${host.name}` : e.venueName, place(e)].filter(Boolean).join(' · ');
const figure = dateFigure(e);
// One link when the ticket page and the event's own page are the same.
const websiteUrl = e.officialUrl && e.officialUrl !== e.ticketUrl ? e.officialUrl : null;
const hasBody = !!e.description || e.venues.length > 0;
---
<Base title={e.name} description={description} current="events">
  <header class="band">
    <div class="wrap inner">
      <div class="title-block">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/events">Events</a></nav>
        <h1>{e.name}</h1>
        {byline && <p class="byline">{byline}</p>}
        <ul class="labels" aria-label="Kind of event">
          {[e.type, ...e.tags].map((t) => <li>{t}</li>)}
          {e.cancelled && <li class="cancelled">Cancelled</li>}
        </ul>
      </div>
      <p class="figure" aria-hidden="true">
        <span class="figure-days">{figure.big}</span>
        <span class="figure-rest">{figure.rest}</span>
      </p>
    </div>
  </header>

  <div class:list={['wrap', 'layout', { solo: !hasBody }]}>
    <aside class="facts-card" aria-label="When and where">
      <dl class="facts">
        <div>
          <dt>When</dt>
          <dd>{formatWhen(e)}</dd>
          {e.startTime && e.city && <dd class="sub">Local time in {e.city}</dd>}
        </div>
        {where && (
          <div>
            <dt>Where</dt>
            <dd>{where}</dd>
            {e.address && <dd class="sub">{e.address}</dd>}
          </div>
        )}
        <div>
          <dt>Admission</dt>
          <dd>{e.admission}</dd>
          {e.admissionNote && <dd class="sub">{e.admissionNote}</dd>}
        </div>
      </dl>

      {!e.cancelled && (
        <div class="actions">
          <SaveControls type="event" id={e.id} appLabel="Say you’re going in the app" variant="solid" event={e} />
          {(e.ticketUrl || websiteUrl) && (
            <p class="links">
              {e.ticketUrl && <a href={e.ticketUrl} rel="noopener">Tickets →</a>}
              {websiteUrl && <a href={websiteUrl} rel="noopener">Event website →</a>}
            </p>
          )}
        </div>
      )}
    </aside>

    {hasBody && (
      <article class="main">
        {e.description && (
          <section class="about">
            {e.description.split(/\n\s*\n/).map((p) => <p>{p.trim()}</p>)}
          </section>
        )}

        {e.venues.length > 0 && (
          <section class="venues" aria-labelledby="at-this-event">
            <h2 id="at-this-event">At this event</h2>
            <ul>
              {e.venues.map((v) => {
                const inner = (
                  <>
                    <span class="venue-name">{v.name}</span>
                    <span class="venue-meta">{v.kind} · {roleLabel(v.roles)}</span>
                    {v.stars !== null && v.stars > 0 && (
                      <span class="stars" aria-label={`${v.stars} MICHELIN star${v.stars === 1 ? '' : 's'}`}>{'★'.repeat(v.stars)}</span>
                    )}
                  </>
                );
                return <li>{v.href ? <a class="venue" href={v.href}>{inner}</a> : <div class="venue">{inner}</div>}</li>;
              })}
            </ul>
          </section>
        )}

        <p class="back"><a href="/events">All events →</a></p>
      </article>
    )}
  </div>
</Base>

<style>
  /* Keynote detail page: a green band with the title and the date set
     large (the event's own artwork while we hold no photo of it), then a
     reading column with the facts card beside it, on the nav's edges. */
  .band { background: var(--green); color: var(--ivory); }
  .inner {
    max-width: 1200px; padding-top: 72px; padding-bottom: 72px;
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 48px; align-items: end;
  }
  .crumbs { font-size: 15px; color: var(--on-green-muted); margin-bottom: 18px; }
  .crumbs a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--on-green-rule); }
  .crumbs a:hover { color: var(--ivory); text-decoration-color: currentColor; }
  h1 {
    font-family: var(--display); font-weight: 300; margin: 0; max-width: 20ch; text-wrap: balance;
    font-size: clamp(38px, 5vw, 72px); line-height: 1.02; letter-spacing: -0.02em;
  }
  .byline { margin: 20px 0 0; font-size: 18px; color: var(--on-green-muted); }
  .labels { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .labels li { font-size: 13px; font-weight: 500; border: 1px solid var(--on-green-rule); border-radius: 999px; padding: 4px 12px; }
  .labels .cancelled { background: var(--ivory); color: var(--green); border-color: var(--ivory); }

  .figure {
    margin: 0; min-width: 240px; padding: 28px 32px; border-radius: 20px;
    background: var(--claret); color: var(--ivory);
    display: flex; flex-direction: column; gap: 10px;
  }
  .figure-days { font-family: var(--display); font-weight: 300; font-size: clamp(56px, 6vw, 96px); line-height: 0.92; letter-spacing: -0.03em; white-space: nowrap; }
  .figure-rest { font-size: 15px; color: var(--on-claret-accent); }

  .layout {
    max-width: 1200px; padding-top: 56px; padding-bottom: 104px;
    display: grid; grid-template-columns: minmax(0, 1fr) 360px; grid-template-areas: 'main aside';
    column-gap: 72px; align-items: start;
  }
  .layout.solo { grid-template-columns: minmax(0, 520px); grid-template-areas: 'aside'; }
  .main { grid-area: main; max-width: 680px; }
  .facts-card {
    grid-area: aside; position: sticky; top: 84px;
    background: var(--paper); border: 1px solid var(--rule); border-radius: 18px; padding: 28px;
  }
  .facts { margin: 0; display: grid; gap: 20px; }
  dt { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
  dd { margin: 4px 0 0; font-family: var(--display); font-size: 21px; line-height: 1.3; }
  dd.sub { font-family: var(--body); font-size: 14px; color: var(--ink-soft); margin-top: 2px; }

  .actions { margin-top: 24px; padding-top: 22px; border-top: 1px solid var(--rule); display: grid; gap: 16px; }
  .actions :global(.sign-in) { font-size: 14px; padding: 12px 4px; }
  .links { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 15px; }
  .links a { display: inline-block; padding: 8px 0; text-decoration: underline; text-underline-offset: 3px; }

  .about p { font-family: var(--display); font-size: 21px; line-height: 1.6; margin: 0 0 20px; white-space: pre-line; }
  .about p:first-child { font-size: 24px; line-height: 1.5; }

  .venues { margin-top: 48px; }
  .venues h2 { font-family: var(--display); font-weight: 300; font-size: 34px; line-height: 1.1; margin: 0 0 8px; }
  .venues ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--green); }
  .venue {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 16px; align-items: baseline;
    padding: 18px 0; border-bottom: 1px solid var(--rule);
  }
  a.venue:hover { text-decoration: none; }
  a.venue:hover .venue-name { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .venue-name { font-family: var(--display); font-size: 26px; line-height: 1.2; }
  .venue-meta { grid-column: 1; font-size: 14px; color: var(--ink-soft); }
  .stars { grid-column: 2; grid-row: 1 / span 2; align-self: center; color: var(--gold); font-size: 18px; letter-spacing: 0.08em; }

  .back { margin-top: 40px; font-size: 15px; }

  @media (max-width: 960px) {
    .inner { grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: start; padding-top: 44px; padding-bottom: 48px; }
    .figure { min-width: 0; justify-self: start; padding: 20px 24px; border-radius: 16px; }
    .figure-days { font-size: 56px; }
    .layout, .layout.solo { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'aside' 'main'; row-gap: 40px; padding-top: 32px; padding-bottom: 72px; }
    .facts-card { position: static; padding: 22px; }
    .about p:first-child { font-size: 21px; }
  }
</style>
