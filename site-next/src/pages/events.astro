---
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import HideEnded from '../components/HideEnded.astro';
import AppCta from '../components/AppCta.astro';
import { BENELUX, dateFigure, formatWhen, loadEvents, monthKey, monthLabel, place, type SiteEvent } from '../lib/events';

const events = await loadEvents();
const months = new Map<string, SiteEvent[]>();
for (const e of events) {
  if (!months.has(monthKey(e))) months.set(monthKey(e), []);
  months.get(monthKey(e))!.push(e);
}

// The featured evening: the next event in the Benelux that isn't
// cancelled and hasn't begun yet (Benelux first, review of 2026-11-21),
// else the next such festival anywhere, else one already running, else
// nothing. Chosen by rule, never by hand, and shown in type only: we hold
// no photo of the event itself. The site rebuilds every three hours.
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Amsterdam' }).format(new Date());
const open = events.filter((e) => !e.cancelled);
const festivals = open.filter((e) => e.type === 'Festival');
const featured = open.find((e) => e.startDate > today && BENELUX.has(e.countryCode ?? ''))
  ?? festivals.find((e) => e.startDate > today) ?? festivals[0];

// The one Filters affordance (CLAUDE.md, UI principle): country and kind,
// each listed only when an upcoming event has it, most events first.
const tally = (key: (e: SiteEvent) => string | null) => {
  const counts = new Map<string, number>();
  for (const e of events) { const k = key(e); if (k) counts.set(k, (counts.get(k) ?? 0) + 1); }
  return [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
};
const countryNames = new Map(events.filter((e) => e.countryCode).map((e) => [e.countryCode!, e.country ?? e.countryCode!]));
const countries = tally((e) => e.countryCode).map(([code, n]) => ({ value: code, label: countryNames.get(code) ?? code, n }));
const types = tally((e) => e.type).map(([type, n]) => ({ value: type, label: type, n }));
const teaser = (text: string | null) => {
  if (!text) return null;
  return text.length > 220 ? `${text.slice(0, 217).trimEnd()}…` : text;
};
---
<Base title="Events" description="Four hands dinners, guest chefs, winemaker dinners, galas and festivals across Europe." current="events">
  <header class="hero">
    <p class="kicker-k accent">Events</p>
    <h1 class="hero-title">Some evenings only happen once.</h1>
    <p class="hero-intro">Four hands dinners, guest chefs, winemaker dinners, galas and festivals. Times are local to each event.</p>
  </header>

  {featured && (() => {
    const d = dateFigure(featured);
    const host = featured.venues.find((v) => v.roles.includes('host'));
    const where = [host?.name ?? featured.venueName, place(featured)].filter(Boolean).join(' · ');
    return (
      <section class="feature-wrap" data-featured data-end-date={featured.endDate} data-tz={featured.timezone ?? 'Europe/Amsterdam'}>
        <a class="feature" href={`/events/${featured.slug}`}>
          <div class="panel">
            <span class="panel-kicker">Featured</span>
            <span class="panel-days">{d.big}</span>
            <span class="panel-month">{d.rest}</span>
          </div>
          <div class="feature-text">
            <span class="feature-type">{featured.type}</span>
            <h2 class="feature-name">{featured.name}</h2>
            <p class="feature-when">{formatWhen(featured)}</p>
            {where && <p class="feature-where">{where}</p>}
            {teaser(featured.description) && <p class="feature-teaser">{teaser(featured.description)}</p>}
            <span class="feature-go">See the event</span>
          </div>
        </a>
      </section>
    );
  })()}

  <section class="wrap list" data-events-scope>
    <div class="filter-bar" data-filters hidden>
      <details class="filters">
        <summary>Filters</summary>
        <div class="filter-panel">
          <label>
            <span>Country</span>
            <select data-filter="country">
              <option value="">Every country</option>
              {countries.map((c) => <option value={c.value}>{c.label} ({c.n})</option>)}
            </select>
          </label>
          <label>
            <span>Kind</span>
            <select data-filter="type">
              <option value="">Every kind</option>
              {types.map((t) => <option value={t.value}>{t.label} ({t.n})</option>)}
            </select>
          </label>
        </div>
      </details>
      <p class="filter-summary" data-filter-summary aria-live="polite"></p>
    </div>
    {[...months.entries()].map(([key, list]) => (
      <div class="month" data-event-group>
        <h2 class="month-title">{monthLabel(key)}</h2>
        <ul>{list.map((e) => <EventRow event={e} />)}</ul>
      </div>
    ))}
    <p class="empty" data-events-empty hidden={events.length > 0}>No upcoming events right now.</p>
    <p class="empty" data-filter-empty hidden>No upcoming events match these filters. <button type="button" class="clear" data-filter-clear>Clear filters</button></p>
  </section>

  <section class="close flush-end">
    <h2 class="close-title">Going? Tell your friends.</h2>
    <p class="close-intro">Mark an evening as Going in the app, see who else is coming, and keep it in your Passport once you have been.</p>
    <AppCta label="Download on the App Store" variant="ivory" size="large" />
  </section>
  <HideEnded />
  <script>
    // Filters run in the browser over the rows the build wrote, after
    // HideEnded: a row hidden because it ended stays hidden. The choice
    // lives in the address (?country=NL&type=Dinner), so it can be shared.
    const bar = document.querySelector<HTMLElement>('[data-filters]');
    if (bar) {
      bar.hidden = false;
      const selects = [...bar.querySelectorAll<HTMLSelectElement>('[data-filter]')];
      const summary = bar.querySelector<HTMLElement>('[data-filter-summary]')!;
      const featured = document.querySelector<HTMLElement>('[data-featured]');
      const noMatch = document.querySelector<HTMLElement>('[data-filter-empty]')!;
      const rows = [...document.querySelectorAll<HTMLElement>('.list [data-end-date]')];
      const params = new URLSearchParams(location.search);
      for (const s of selects) {
        const v = params.get(s.dataset.filter!);
        if (v && [...s.options].some((o) => o.value === v)) s.value = v;
      }

      const apply = () => {
        const chosen = Object.fromEntries(selects.map((s) => [s.dataset.filter!, s.value]));
        const active = selects.filter((s) => s.value);
        let shown = 0;
        for (const row of rows) {
          const match = (!chosen.country || row.dataset.country === chosen.country) && (!chosen.type || row.dataset.type === chosen.type);
          row.classList.toggle('filtered-out', !match);
          if (match && !row.hidden) shown++;
        }
        document.querySelectorAll<HTMLElement>('.list [data-event-group]').forEach((g) => {
          g.classList.toggle('filtered-out', !g.querySelector('[data-end-date]:not([hidden]):not(.filtered-out)'));
        });
        if (featured) featured.classList.toggle('filtered-out', active.length > 0);
        noMatch.hidden = active.length === 0 || shown > 0;
        summary.replaceChildren();
        if (active.length > 0) {
          const text = active.map((s) => s.selectedOptions[0].text.replace(/\s*\(\d+\)$/, '')).join(' · ');
          summary.append(`${text} · ${shown} ${shown === 1 ? 'event' : 'events'} `);
          const clear = document.createElement('button');
          clear.type = 'button'; clear.className = 'clear'; clear.textContent = 'Clear';
          clear.addEventListener('click', reset);
          summary.append(clear);
        }
        const next = new URLSearchParams();
        for (const s of active) next.set(s.dataset.filter!, s.value);
        const query = next.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
      };
      const reset = () => { for (const s of selects) s.value = ''; apply(); };
      selects.forEach((s) => s.addEventListener('change', apply));
      noMatch.querySelector('[data-filter-clear]')?.addEventListener('click', reset);
      apply();
    }
  </script>
</Base>

<style>
  .accent { color: var(--on-green-accent); }

  .hero { background: var(--green); color: var(--ivory); text-align: center; padding: 104px var(--gutter) 136px; }
  .hero-title { font-family: var(--display); font-weight: 300; margin: 0 auto; max-width: 14ch; font-size: clamp(48px, 7vw, 104px); line-height: 0.98; letter-spacing: -0.025em; }
  .hero-intro { margin: 26px auto 0; max-width: 44ch; font-size: 20px; line-height: 1.55; color: var(--on-green-muted); }

  .feature-wrap { padding: 0 var(--gutter); }
  .feature {
    max-width: 1200px; margin: -64px auto 0; display: flex; flex-wrap: wrap;
    background: var(--card); border-radius: 28px; overflow: hidden; box-shadow: 0 40px 80px -48px rgba(14, 33, 28, 0.5);
  }
  .feature:hover { text-decoration: none; }
  .feature:hover .feature-go { text-decoration: underline; text-underline-offset: 4px; }
  .panel {
    flex: 1 1 480px; min-height: 380px; background: var(--claret); color: var(--ivory);
    display: flex; flex-direction: column; justify-content: space-between; gap: 16px; padding: 44px; box-sizing: border-box;
  }
  .panel-kicker { font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-claret-accent); }
  .panel-days { font-family: var(--display); font-weight: 300; font-size: clamp(64px, 9vw, 140px); line-height: 0.92; letter-spacing: -0.03em; }
  .panel-month { font-size: 15px; color: rgba(244, 240, 231, 0.8); }
  .feature-text { flex: 1 1 380px; padding: 48px; box-sizing: border-box; display: flex; flex-direction: column; gap: 12px; }
  .feature-type { font-size: 13px; font-weight: 600; color: var(--claret); }
  .feature-name { margin: 0; font-family: var(--display); font-weight: 300; font-size: clamp(34px, 3.6vw, 52px); line-height: 1.02; }
  .feature-when, .feature-where { margin: 0; font-size: 16px; color: var(--ink-soft); }
  .feature-teaser { margin: 4px 0 0; font-size: 16px; line-height: 1.6; color: var(--ink-soft); }
  .feature-go { margin-top: auto; padding-top: 12px; font-size: 16px; color: var(--forest); }

  .list { padding-top: 72px; padding-bottom: 120px; max-width: 1200px; }
  .list :global(.filtered-out), :global(.feature-wrap.filtered-out) { display: none; }

  .filter-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-bottom: 40px; }
  .filters { position: relative; }
  .filters summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 10px;
    min-height: 44px; padding: 0 20px; border: 1px solid var(--green); border-radius: 999px;
    font-size: 15px; font-weight: 600;
  }
  .filters summary::-webkit-details-marker { display: none; }
  .filters summary::after { content: ''; width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); }
  .filters[open] summary { background: var(--green); color: var(--ivory); }
  .filters[open] summary::after { transform: translateY(2px) rotate(-135deg); }
  .filter-panel {
    position: absolute; z-index: 5; top: calc(100% + 10px); left: 0; width: min(360px, calc(100vw - 2 * var(--gutter)));
    display: grid; gap: 16px; padding: 22px; background: var(--paper); border: 1px solid var(--rule); border-radius: 18px;
    box-shadow: 0 24px 48px -28px rgba(14, 33, 28, 0.45);
  }
  .filter-panel label { display: grid; gap: 6px; font-size: 13px; font-weight: 600; color: var(--ink-soft); }
  .filter-panel select {
    font: inherit; font-size: 16px; font-weight: 400; color: var(--green); min-height: 44px; padding: 0 12px;
    background: var(--ivory); border: 1px solid var(--rule); border-radius: 10px;
  }
  .filter-summary { margin: 0; font-size: 15px; color: var(--ink-soft); }
  .list :global(.clear) { font: inherit; color: var(--green); background: none; border: 0; padding: 10px 4px; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .month + .month { margin-top: 56px; }
  .month-title { font-family: var(--display); font-weight: 300; font-size: 44px; line-height: 1.1; margin: 0; padding-bottom: 6px; border-bottom: 1px solid var(--green); }
  .empty { color: var(--ink-soft); margin-top: 32px; }

  .close { background: var(--green); color: var(--ivory); text-align: center; padding: 120px var(--gutter); display: flex; flex-direction: column; align-items: center; gap: 24px; }
  .close-title { font-family: var(--display); font-weight: 300; font-size: clamp(40px, 5vw, 72px); line-height: 1; margin: 0; max-width: 16ch; }
  .close-intro { margin: 0 0 12px; max-width: 40ch; font-size: 19px; line-height: 1.55; color: var(--on-green-muted); }

  @media (max-width: 760px) {
    .hero { padding: 56px var(--gutter) 96px; }
    .hero-intro { font-size: 17px; }
    .panel { min-height: 220px; padding: 28px; }
    .feature-text { padding: 28px; }
    .list { padding-top: 48px; padding-bottom: 72px; }
    .month-title { font-size: 34px; }
    .close { padding: 72px var(--gutter); }
  }
</style>
