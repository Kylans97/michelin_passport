---
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import HideEnded from '../components/HideEnded.astro';
import AppCta from '../components/AppCta.astro';
import PageHeader from '../components/PageHeader.astro';
import { loadEvents, monthKey, monthLabel, type SiteEvent } from '../lib/events';

const events = await loadEvents();
const months = new Map<string, SiteEvent[]>();
for (const e of events) {
  if (!months.has(monthKey(e))) months.set(monthKey(e), []);
  months.get(monthKey(e))!.push(e);
}
---
<Base title="Events" description="Four-hands dinners, guest chefs, winemaker dinners, galas and festivals across Europe." current="events">
  <PageHeader title="Events" intro="Four-hands dinners, guest chefs, winemaker dinners, galas and festivals. Times are local to each event.">
    <AppCta slot="aside" label="Mark an evening as Going in the app" variant="on-green" />
  </PageHeader>

  <section class="wrap list" data-events-scope>
    {[...months.entries()].map(([key, list]) => (
      <div class="month" data-event-group>
        <h2 class="display month-title">{monthLabel(key)}</h2>
        <ul>{list.map((e) => <EventRow event={e} />)}</ul>
      </div>
    ))}
    <p class="empty" data-events-empty hidden={events.length > 0}>No upcoming events right now.</p>
  </section>
  <HideEnded />
</Base>

<style>
  .list { padding-top: 16px; }
  .list > * { max-width: 1000px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .month { margin-top: 32px; }
  .month-title { font-size: 28px; padding-bottom: 8px; border-bottom: 1px solid var(--green); }
  .empty { color: var(--ink-soft); margin-top: 32px; }
</style>
