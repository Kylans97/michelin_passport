---
import Base from '../layouts/Base.astro';
import AppCta from '../components/AppCta.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FeatureStory from '../components/FeatureStory.astro';
import GuideScores from '../components/GuideScores.astro';
import EventRow from '../components/EventRow.astro';
import HideEnded from '../components/HideEnded.astro';
import { loadArticles } from '../lib/news';
import { guideCount, loadCatalogue, place } from '../lib/restaurants';
import { loadEvents } from '../lib/events';

// Layout B (product owner, 2026-11-16): the lead story as a green panel
// beside its photo, then what's coming up beside the latest stories, then
// one restaurant across every guide. A block with nothing to show is left
// out, never shown as a placeholder.

// The lead is the newest interview (else the newest article).
const articles = await loadArticles();
const lead = articles.find((a) => a.section === 'interview') ?? articles[0];
const others = articles.filter((a) => a !== lead);
const moreInterviews = others.filter((a) => a.section === 'interview').slice(0, 3);

// The next events that aren't cancelled. Spare rows ride along so that,
// after HideEnded removes ended ones, a stale build still shows five.
const upcoming = (await loadEvents()).filter((e) => !e.cancelled).slice(0, 10);

// "One restaurant, every guide": the open restaurant the most guides
// recognise, best World's 50 Best rank breaking a tie. Chosen by rule, so
// the block changes when the guides do.
const catalogue = await loadCatalogue();
const featured = catalogue.restaurants
  .filter((r) => !r.closed)
  .sort((a, b) =>
    guideCount(b) - guideCount(a)
    || (a.w50bRank ?? 999) - (b.w50bRank ?? 999)
    || (b.stars ?? 0) - (a.stars ?? 0)
    || a.code.localeCompare(b.code))[0];
---
<Base description="Guide news, chef interviews and one-off dinners across Europe.">
  <h1 class="sr-only">Mantelier: restaurant guides, interviews and gastronomy events</h1>

  {lead && <FeatureStory article={lead} tone="green" />}

  <section class="wrap now">
    <div class="coming" data-events-scope>
      <div class="head">
        <p class="eyebrow">Coming up</p>
        <a class="more" href="/events">All events →</a>
      </div>
      {upcoming.length > 0 && <ul class="events" data-home-events>{upcoming.map((e) => <EventRow event={e} />)}</ul>}
      <p class="empty" data-events-empty hidden={upcoming.length > 0}>We add new events every week.</p>
      <div class="cta"><AppCta label="Mark an evening as Going in the app" /></div>
    </div>

    <aside class="latest" aria-labelledby="latest">
      <p class="eyebrow" id="latest">Latest</p>
      {others.slice(0, 4).map((a) => <ArticleCard article={a} variant="row" />)}
      <a class="row-link" href="/guides">
        <span class="eyebrow">Guides</span>
        <span class="display row-title">Where the guides agree</span>
      </a>
    </aside>
  </section>

  {featured && (
    <section class="wrap" aria-labelledby="every-guide">
      <div class="compare">
        <div class="compare-head">
          <div>
            <p class="eyebrow" id="every-guide">One restaurant, every guide</p>
            <p class="display compare-title"><a href={`/restaurants/${featured.slug}`}>{featured.name}</a><span class="compare-place"> · {place(featured)}</span></p>
          </div>
          <AppCta label="Add to wishlist in the app" />
        </div>
        <GuideScores restaurant={featured} w50bYear={catalogue.w50bYear} />
        <a class="more right" href="/guides">Compare every guide →</a>
      </div>
    </section>
  )}

  {moreInterviews.length > 0 && (
    <section class="wrap behind" aria-labelledby="behind">
      <div class="head">
        <p class="eyebrow" id="behind">Behind the pass</p>
        <a href="/behind-the-pass" class="more">All interviews →</a>
      </div>
      <div class="grid3">{moreInterviews.map((a) => <ArticleCard article={a} />)}</div>
    </section>
  )}

  <HideEnded />
  <script is:inline>
    // Five rows at most, counted after ended ones are hidden.
    document.querySelectorAll('[data-home-events] > li:not([hidden])').forEach((li, i) => { if (i >= 5) li.hidden = true; });
  </script>
</Base>

<style>
  .now { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 56px; padding-top: 56px; }
  .head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 10px; border-bottom: 1px solid var(--green); }
  .more { font-size: 13px; color: var(--ink-soft); }
  .right { align-self: flex-end; }
  .events { list-style: none; margin: 0; padding: 0; }
  .empty { color: var(--ink-soft); margin: 16px 0 0; }
  .cta { margin-top: 20px; }

  .latest { display: flex; flex-direction: column; gap: 14px; }
  .latest > .eyebrow { padding-bottom: 10px; border-bottom: 1px solid var(--green); }
  .row-link { display: flex; flex-direction: column; gap: 6px; border-bottom: 1px solid var(--rule); padding-bottom: 14px; }
  .row-link:hover { text-decoration: none; }
  .row-link:hover .row-title { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .row-title { font-size: 20px; line-height: 1.2; }

  .compare {
    margin-top: 64px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .compare-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .compare-title { font-size: 30px; margin-top: 4px; }
  .compare-place { color: var(--ink-soft); font-size: 22px; }

  .behind { margin-top: 64px; }
  .behind .head { margin-bottom: 18px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }

  @media (max-width: 900px) {
    .now { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 36px; }
  }
  @media (max-width: 760px) {
    .grid3 { grid-template-columns: minmax(0, 1fr); }
    .compare { padding: 20px; }
  }
</style>
