---
import Base from '../layouts/Base.astro';
import RestaurantRow from '../components/RestaurantRow.astro';
import PageHeader from '../components/PageHeader.astro';
import { GUIDES } from '../lib/guides';
import { guideCount, loadCatalogue } from '../lib/restaurants';

const catalogue = await loadCatalogue();
const guides = GUIDES.map((g) => ({ guide: g, count: g.members(catalogue).length }));

// Where the guides agree: open restaurants recognised by three or more of
// them, best World's 50 Best rank first, then most stars.
const agreed = catalogue.restaurants
  .filter((r) => !r.closed && guideCount(r) >= 3)
  .sort((a, b) =>
    guideCount(b) - guideCount(a)
    || (a.w50bRank ?? 999) - (b.w50bRank ?? 999)
    || (b.stars ?? 0) - (a.stars ?? 0)
    || a.name.localeCompare(b.name));
---
<Base title="Guides" description="MICHELIN, The World’s 50 Best, Gault&Millau and our own Mantelier Selection, side by side." current="guides">
  <PageHeader eyebrow={`${catalogue.restaurants.length} restaurants`} title="Guides" intro="Every guide judges differently. Here they sit side by side: on each restaurant’s page, and in their own lists." />

  <section class="wrap body">
    <ul class="guides">
      {guides.map(({ guide, count }) => (
        <li>
          <a href={`/guides/${guide.slug}`} class="guide">
            <span class="display guide-name">{guide.slug === 'worlds-50-best' && catalogue.w50bYear ? `${guide.name} ${catalogue.w50bYear}` : guide.name}</span>
            <span class="guide-intro">{guide.intro}</span>
            <span class="util guide-count">{count} restaurants →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {agreed.length > 0 && (
    <section class="wrap agreed" aria-labelledby="agreed">
      <p class="eyebrow" id="agreed">Where the guides agree</p>
      <p class="display agreed-title">Recognised by three guides or more</p>
      <ul class="two-col">{agreed.map((r) => <RestaurantRow restaurant={r} />)}</ul>
    </section>
  )}
</Base>

<style>
  .body { padding-top: 48px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .guides { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .guide { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 22px; background: var(--paper); border: 1px solid var(--rule); border-radius: 6px; }
  .guide:hover { text-decoration: none; border-color: var(--ink-soft); }
  .guide-name { font-size: 26px; }
  .guide-intro { font-size: 14px; color: var(--ink-soft); flex: 1; }
  .guide-count { color: var(--taupe); font-size: 11px; }
  .agreed { margin-top: 56px; }
  .agreed-title { font-size: 28px; margin: 6px 0 12px; }
  @media (max-width: 1100px) { .guides { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .guides { grid-template-columns: minmax(0, 1fr); } .body { padding-top: 28px; } }
</style>
