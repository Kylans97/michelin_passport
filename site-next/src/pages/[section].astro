---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SECTIONS } from '../config';

export function getStaticPaths() {
  // The sections whose content isn't built yet. A section leaves this list
  // for its own page once it has content (news.astro, behind-the-pass.astro, guides.astro, events.astro).
  // Inside getStaticPaths because Astro runs it apart from the page body.
  const intros: Record<string, { intro: string }> = {
    trends: { intro: 'Where fine dining is heading.' },
  };
  return SECTIONS.filter((s) => s.slug in intros).map((s) => ({
    params: { section: s.slug },
    props: { label: s.label, info: intros[s.slug] },
  }));
}

const { section } = Astro.params;
const { label, info } = Astro.props;
---
<Base title={label} description={info.intro} current={section}>
  <PageHeader title={label} intro={info.intro} />
  <section class="wrap body">
    <p class="empty">Nothing here yet.</p>
  </section>
</Base>

<style>
  .body { padding-top: 48px; }
  .empty { color: var(--ink-soft); font-size: 17px; }
</style>
