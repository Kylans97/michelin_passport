---
// Sign in with a Mantelier app account: with Apple, with a six digit code
// by email, or with email and password; then the code from the
// authenticator app for an account with two-step sign-in on, as the app's
// entrance and TwoStepSignInScreen. The page itself is static; everything
// happens in the browser.
import Base from '../../layouts/Base.astro';
import { CONTACT_EMAIL } from '../../config';
import '../../styles/account.css';
---
<Base title="Sign in" description="Sign in with your Mantelier account." noindex>
  <section class="stage flush-end">
    <div class="wrap stage-grid">
      <div class="intro">
        <p class="kicker-k">Sign in</p>
        <h1 class="title">Your Passport, on the web.</h1>
        <p class="sub">Sign in with the account you use in the Mantelier app.</p>
      </div>
      <div class="card">
      <form class="form" data-step="password" novalidate>
        <button class="apple-button" type="button" data-apple>
          <svg width="16" height="19" viewBox="0 0 17 20" aria-hidden="true"><path fill="currentColor" d="M14.1 10.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.1-1.2 2.9-2.4.9-1.3 1.3-2.6 1.3-2.7 0 0-2.5-1-2.4-3.9zM11.7 3.4c.7-.8 1.1-1.9 1-3-1 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.5 2.8-1.3z"/></svg>
          Continue with Apple
        </button>
        <button class="outline-button" type="button" data-email-code>Continue with email</button>
        <p class="divider"><span>or with your password</span></p>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="username" required>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <p class="notice error" data-error hidden></p>
        <p class="notice ok" data-ok hidden></p>
        <button class="text-button" type="button" data-resend hidden>Send a new confirmation link</button>
        <button class="button" type="submit">Sign in</button>
        <p class="help">Forgot your password? Reset it in the Mantelier app: on its sign-in screen, tap “Forgot password?”.</p>
        <p class="help">No account yet? Accounts are made in the Mantelier app.</p>
      </form>

      <form class="form" data-step="email" novalidate hidden>
        <p class="lead" data-email-title>Your email</p>
        <p class="help" data-email-help>We send a six digit code to the address of your Mantelier account.</p>
        <div class="field" data-address>
          <label for="code-email">Email</label>
          <input id="code-email" name="email" type="email" autocomplete="username" required>
        </div>
        <div class="field" data-code hidden>
          <label for="email-code">Code</label>
          <input class="code" id="email-code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="123456">
        </div>
        <p class="notice error" data-error hidden></p>
        <button class="button" type="submit" data-send>Send code</button>
        <button class="text-button" type="button" data-again hidden>Send a new code</button>
        <button class="text-button" type="button" data-back>Back</button>
      </form>

      <form class="form" data-step="code" novalidate hidden>
        <p class="lead">Two-step sign-in</p>
        <p class="help">Enter the code from your authenticator app.</p>
        <div class="field">
          <label for="code">Code</label>
          <input class="code" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="123456" required>
        </div>
        <p class="notice error" data-error hidden></p>
        <button class="button" type="submit">Continue</button>
        <p class="help">Lost the phone with your authenticator? Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we will help you back in.</p>
        <button class="text-button" type="button" data-sign-out>Sign out</button>
      </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .stage { background: var(--green); color: var(--ivory); padding: 96px 0 120px; }
  .stage-grid { display: flex; flex-wrap: wrap; gap: 72px; align-items: center; justify-content: center; max-width: 1100px; }
  .intro { flex: 1 1 360px; max-width: 460px; }
  .intro .kicker-k { color: var(--on-green-accent); }
  .title { font-family: var(--display); font-weight: 300; font-size: clamp(44px, 5.6vw, 80px); line-height: 1; letter-spacing: -0.02em; margin: 0; }
  .sub { margin: 18px 0 0; font-size: 19px; line-height: 1.55; color: var(--on-green-muted); }
  .card {
    flex: 0 1 440px; background: var(--ivory); color: var(--green); border-radius: 28px; padding: 40px;
    box-shadow: 0 50px 90px -40px rgba(0, 0, 0, 0.6);
  }
  .card :global(.button[type='submit']) { align-self: stretch; margin-top: 6px; }
  .card :global(.help) { font-size: 14px; line-height: 1.55; }
  .apple-button, .outline-button {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 48px; border-radius: 999px; font: inherit; font-size: 16px; font-weight: 500; cursor: pointer;
  }
  .apple-button { background: #000; color: #fff; border: 0; }
  .outline-button { background: transparent; color: var(--green); border: 1px solid currentColor; }
  .apple-button:disabled, .outline-button:disabled { opacity: 0.5; cursor: default; }
  .divider { display: flex; align-items: center; gap: 12px; margin: 6px 0 0; font-size: 13px; opacity: 0.7; }
  .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: currentColor; opacity: 0.3; }
  @media (max-width: 760px) {
    .stage { padding: 48px 0 64px; }
    .stage-grid { gap: 36px; }
    .card { padding: 28px 22px; border-radius: 24px; }
  }
</style>

<script>
  import {
    completeAppleSignIn, loadName, resendConfirmation, sendEmailCode, signIn, signOut, startAppleSignIn,
    supabase, verifyEmailCode, verifyTwoStep,
  } from '../../lib/account/client';
  import { peek, safeNext } from '../../lib/account/peek';

  let next = safeNext(new URLSearchParams(location.search).get('next'));
  const passwordForm = document.querySelector<HTMLFormElement>('[data-step="password"]')!;
  const codeForm = document.querySelector<HTMLFormElement>('[data-step="code"]')!;
  const resend = passwordForm.querySelector<HTMLButtonElement>('[data-resend]')!;
  const ok = passwordForm.querySelector<HTMLElement>('[data-ok]')!;
  let unconfirmedEmail: string | null = null;

  const showError = (form: HTMLFormElement, message: string | null) => {
    const el = form.querySelector<HTMLElement>('[data-error]')!;
    el.textContent = message ?? '';
    el.hidden = !message;
  };
  const busy = (form: HTMLFormElement, on: boolean) => {
    form.querySelector<HTMLButtonElement>('button[type="submit"]')!.disabled = on;
  };

  async function finish() {
    const { data } = await supabase().auth.getUser();
    if (data.user) await loadName(data.user.id);
    location.replace(next);
  }

  function showCodeStep() {
    passwordForm.hidden = true;
    codeForm.hidden = false;
    codeForm.querySelector<HTMLInputElement>('#code')!.focus();
  }

  // Back from Apple, already signed in, or signed in but not past the code.
  (async () => {
    try {
      const back = await completeAppleSignIn();
      if (back) {
        if (back.next) next = safeNext(back.next);
        if (back.result === 'not-set-up') {
          showError(passwordForm, 'This Apple account has no Mantelier account yet. Make yours in the Mantelier app first, then sign in here.');
        } else if (back.result === 'needs-two-step') showCodeStep();
        else await finish();
        return;
      }
    } catch (e) {
      showError(passwordForm, e instanceof Error && e.message ? e.message : 'Something went wrong. Please try again.');
      return;
    }
    const state = peek();
    if (state === 'signed-in') location.replace(next);
    else if (state === 'needs-two-step') showCodeStep();
  })();

  const appleButton = passwordForm.querySelector<HTMLButtonElement>('[data-apple]')!;
  appleButton.addEventListener('click', async () => {
    appleButton.disabled = true;
    showError(passwordForm, null);
    try {
      await startAppleSignIn(next);
    } catch (e) {
      showError(passwordForm, e instanceof Error ? e.message : 'Something went wrong. Please try again.');
      appleButton.disabled = false;
    }
  });

  // Continue with email: the address, then the six digit code.
  const emailForm = document.querySelector<HTMLFormElement>('[data-step="email"]')!;
  const emailInput = emailForm.querySelector<HTMLInputElement>('#code-email')!;
  const emailCodeInput = emailForm.querySelector<HTMLInputElement>('#email-code')!;
  const sendButton = emailForm.querySelector<HTMLButtonElement>('[data-send]')!;
  const againButton = emailForm.querySelector<HTMLButtonElement>('[data-again]')!;
  let sentTo: string | null = null;

  function showAddressStep() {
    sentTo = null;
    emailForm.querySelector<HTMLElement>('[data-email-title]')!.textContent = 'Your email';
    emailForm.querySelector<HTMLElement>('[data-email-help]')!.textContent = 'We send a six digit code to the address of your Mantelier account.';
    emailForm.querySelector<HTMLElement>('[data-address]')!.hidden = false;
    emailForm.querySelector<HTMLElement>('[data-code]')!.hidden = true;
    sendButton.hidden = false;
    againButton.hidden = true;
    emailCodeInput.value = '';
    showError(emailForm, null);
  }

  passwordForm.querySelector('[data-email-code]')!.addEventListener('click', () => {
    passwordForm.hidden = true;
    emailForm.hidden = false;
    showAddressStep();
    const typed = (passwordForm.elements.namedItem('email') as HTMLInputElement).value.trim();
    if (typed) emailInput.value = typed;
    emailInput.focus();
  });

  emailForm.querySelector('[data-back]')!.addEventListener('click', () => {
    if (sentTo) return showAddressStep();
    emailForm.hidden = true;
    passwordForm.hidden = false;
  });

  async function send(email: string) {
    showError(emailForm, null);
    sendButton.disabled = againButton.disabled = true;
    try {
      await sendEmailCode(email);
      sentTo = email;
      emailForm.querySelector<HTMLElement>('[data-email-title]')!.textContent = 'Check your mail';
      emailForm.querySelector<HTMLElement>('[data-email-help]')!.textContent =
        `If ${email} has a Mantelier account, a six digit code is on its way.`;
      emailForm.querySelector<HTMLElement>('[data-address]')!.hidden = true;
      emailForm.querySelector<HTMLElement>('[data-code]')!.hidden = false;
      sendButton.hidden = true;
      againButton.hidden = false;
      emailCodeInput.focus();
    } catch (e) {
      showError(emailForm, e instanceof Error && e.message ? e.message : 'Something went wrong. Please try again.');
    }
    sendButton.disabled = againButton.disabled = false;
  }

  emailForm.addEventListener('submit', (event) => {
    event.preventDefault();
    if (sentTo) return;
    const email = emailInput.value.trim();
    if (!email.includes('@')) return showError(emailForm, 'Enter a valid email.');
    send(email);
  });
  againButton.addEventListener('click', () => { if (sentTo) send(sentTo); });

  let checkingCode = false;
  emailCodeInput.addEventListener('input', async () => {
    if (!sentTo || checkingCode || emailCodeInput.value.replace(/[^0-9]/g, '').length !== 6) return;
    checkingCode = true;
    showError(emailForm, null);
    try {
      const result = await verifyEmailCode(sentTo, emailCodeInput.value);
      if (result === 'needs-two-step') {
        emailForm.hidden = true;
        showCodeStep();
      } else {
        await finish();
        return;
      }
    } catch (e) {
      showError(emailForm, e instanceof Error && e.message ? e.message : 'Something went wrong. Please try again.');
    }
    checkingCode = false;
  });

  passwordForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = (passwordForm.elements.namedItem('email') as HTMLInputElement).value.trim();
    const password = (passwordForm.elements.namedItem('password') as HTMLInputElement).value;
    showError(passwordForm, null);
    ok.hidden = true;
    resend.hidden = true;
    if (!email || !password) {
      showError(passwordForm, 'Enter your email and password.');
      return;
    }
    busy(passwordForm, true);
    try {
      const result = await signIn(email, password);
      if (result === 'unconfirmed') {
        unconfirmedEmail = email;
        showError(passwordForm, 'Your email isn’t confirmed yet. Use the link in the email we sent you, or send a new one.');
        resend.hidden = false;
      } else if (result === 'needs-two-step') {
        showCodeStep();
      } else {
        await finish();
        return;
      }
    } catch (e) {
      showError(passwordForm, e instanceof Error && e.message ? e.message : 'Something went wrong. Please try again.');
    }
    busy(passwordForm, false);
  });

  resend.addEventListener('click', async () => {
    if (!unconfirmedEmail) return;
    resend.disabled = true;
    try {
      await resendConfirmation(unconfirmedEmail);
      showError(passwordForm, null);
      resend.hidden = true;
      ok.textContent = 'A new confirmation link is on its way. Open it, then sign in here.';
      ok.hidden = false;
    } catch (e) {
      showError(passwordForm, e instanceof Error && e.message ? e.message : 'Something went wrong. Please try again.');
    }
    resend.disabled = false;
  });

  const codeInput = codeForm.querySelector<HTMLInputElement>('#code')!;
  let verifying = false;
  async function submitCode() {
    if (verifying) return;
    showError(codeForm, null);
    if (codeInput.value.replace(/[^0-9]/g, '').length !== 6) {
      showError(codeForm, 'Enter the six-digit code.');
      return;
    }
    verifying = true;
    busy(codeForm, true);
    try {
      await verifyTwoStep(codeInput.value);
      await finish();
      return;
    } catch {
      showError(codeForm, 'That code didn’t match. Try the newest one.');
    }
    verifying = false;
    busy(codeForm, false);
  }
  codeForm.addEventListener('submit', (event) => { event.preventDefault(); submitCode(); });
  // Six digits submit by themselves, as in the app.
  codeInput.addEventListener('input', () => {
    if (codeInput.value.replace(/[^0-9]/g, '').length === 6) submitCode();
  });

  codeForm.querySelector('[data-sign-out]')!.addEventListener('click', async () => {
    await signOut();
    codeForm.hidden = true;
    passwordForm.hidden = false;
  });
</script>
