---
import Base from '../../layouts/Base.astro';
import RestaurantRow from '../../components/RestaurantRow.astro';
import PageHeader from '../../components/PageHeader.astro';
import { GUIDES, byCountry, guideEdition, type Guide } from '../../lib/guides';
import { loadCatalogue } from '../../lib/restaurants';
import { slugify } from '../../lib/news';

export function getStaticPaths() {
  return GUIDES.map((guide) => ({ params: { guide: guide.slug }, props: { guide } }));
}

interface Props { guide: Guide; }
const { guide } = Astro.props;
const catalogue = await loadCatalogue();
const members = guide.members(catalogue);
// A ranked list shows a gap in our data as a gap, never closes it up:
// a missing rank gets its own quiet row.
const ranked: ({ rank: number; r?: (typeof members)[number] })[] = [];
const rankOf = guide.rankOf ?? ((r: (typeof members)[number]) => r.w50bRank);
const isRanked = !guide.grouped && (guide.slug === 'worlds-50-best' || !!guide.rankOf);
if (isRanked && members.length > 0) {
  const byRank = new Map(members.map((r) => [rankOf(r)!, r]));
  const last = Math.max(...byRank.keys());
  for (let rank = 1; rank <= last; rank++) ranked.push({ rank, r: byRank.get(rank) });
}
// Long guides (MICHELIN) list their countries here and each country on
// its own page; short ones open every country in place.
const split = guide.slug === 'michelin';
const edition = guideEdition(guide, catalogue);
const year = guide.slug === 'worlds-50-best' ? catalogue.w50bYear : edition.year;
const title = year ? `${guide.name} ${year}` : guide.name;
---
<Base title={title} description={guide.intro} current="guides">
  <PageHeader eyebrow={`<a href="/guides">Guides</a> · ${members.length} restaurants`} title={title} intro={guide.intro} />
  {edition.note && <p class="wrap coverage">{edition.note}</p>}

  <section class="wrap list">
    {split
      ? <ul class="countries">{byCountry(members).map(([country, list]) => (
          <li><a href={`/guides/${guide.slug}/${slugify(country)}`}><span class="display country">{country}</span><span class="count">{list.length}</span></a></li>
        ))}</ul>
      : guide.grouped
      ? byCountry(members).map(([country, list], i) => (
          <details open={i < 3}>
            <summary><span class="display country">{country}</span><span class="count">{list.length}</span></summary>
            <ul class="two-col">{list.map((r) => <RestaurantRow restaurant={r} />)}</ul>
          </details>
        ))
      : !isRanked
      ? <ul class="two-col">{members.map((r) => <RestaurantRow restaurant={r} lead={guide.leadOf?.(r) ?? undefined} />)}</ul>
      : <ul class="two-col">{ranked.map(({ rank, r }) => r
          ? <RestaurantRow restaurant={r} lead={`${rank}`} />
          : <li class="gap"><span class="gap-rank">{rank}</span><span>Not in our data yet</span></li>)}</ul>}
  </section>
</Base>

<style>
  .list { padding-top: 40px; }
  .coverage { margin-top: 14px; font-size: 13px; color: var(--taupe); max-width: 820px; }
  ul { list-style: none; margin: 0; padding: 0; }
  details { border-top: 1px solid var(--rule); }
  details:last-child { border-bottom: 1px solid var(--rule); }
  summary { display: flex; justify-content: space-between; align-items: baseline; padding: 14px 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 18px; color: var(--taupe); margin-left: 12px; }
  details[open] summary::after { content: '–'; }
  .country { font-size: 24px; flex: 1; }
  .count { font-family: var(--util); font-size: 12px; color: var(--taupe); }
  details ul { padding-bottom: 18px; }
  .countries { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 28px; }
  @media (max-width: 1100px) { .countries { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .countries a { display: flex; align-items: baseline; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .countries .country { font-size: 20px; }
  @media (max-width: 760px) { .countries { grid-template-columns: minmax(0, 1fr); } }
  .gap { display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--rule); font-size: 13px; color: var(--taupe); font-style: italic; }
  .gap-rank { font-family: var(--util); font-style: normal; font-size: 12px; min-width: 2.6em; }
</style>
